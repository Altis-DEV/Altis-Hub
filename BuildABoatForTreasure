local function GetEmptyTeam()

    for _, team in ipairs(
        Teams:GetChildren()
    ) do

        if team:IsA("Team") then

            local teamLeader =
                team:FindFirstChild(
                    "TeamLeader"
                )

            if teamLeader
                and (
                    teamLeader.Value == ""
                    or teamLeader.Value == nil
                )
            then
                return team
            end
        end
    end

    return nil
end

--============================================================
-- KIỂM TRA CYCLE
--============================================================

local function IsCycleValid(
    cycleId,
    character,
    humanoid,
    rootPart
)

    if not getgenv().Farm then
        return false
    end

    if cycleId ~= FarmCycleId then
        return false
    end

    if player.Character ~= character then
        return false
    end

    if not character
        or not character.Parent
    then
        return false
    end

    if not humanoid
        or not humanoid.Parent
        or humanoid.Health <= 0
    then
        return false
    end

    if not rootPart
        or not rootPart.Parent
    then
        return false
    end

    return true
end

--============================================================
-- SAFE WAIT
--============================================================

local function SafeWait(
    seconds,
    humanoid,
    character,
    cycleId
)

    local t = 0

    while t < seconds do

        if not getgenv().Farm then
            return false
        end

        if cycleId ~= FarmCycleId then
            return false
        end

        if player.Character ~= character then
            return false
        end

        if not humanoid
            or not humanoid.Parent
        then
            return false
        end

        if humanoid.Health <= 0 then
            return false
        end

        local dt =
            task.wait(0.1)

        t += dt
    end

    return true
end

--============================================================
-- TELEPORT STAGE
--============================================================

local function teleportToStage(
    rootPart,
    stage
)

    local targetPos =
        startPos
        + Vector3.new(
            0,
            0,
            (stage - 1) * zOffset
        )

    rootPart.CFrame =
        CFrame.new(
            targetPos
            + Vector3.new(0, 3, 0)
        )
end

