--============================================================
-- FARM LOOP
--============================================================

task.spawn(function()

    while true do

        -- Farm OFF
        if not getgenv().Farm then
            task.wait(0.1)
            continue
        end

        local character =
            player.Character

        if not character then
            task.wait(0.1)
            continue
        end

        local rootPart =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        local humanoid =
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        if not rootPart
            or not humanoid
        then
            task.wait(0.1)
            continue
        end

        if humanoid.Health <= 0 then
            task.wait(0.1)
            continue
        end

        local cycleId =
            FarmCycleId

        local finishedAllStages = true

        --====================================================
        -- 9 STAGES
        --====================================================

        for i = 1, totalStages do

            if not IsCycleValid(
                cycleId,
                character,
                humanoid,
                rootPart
            ) then

                finishedAllStages = false
                break
            end

            -- Claim
            if ClaimEvent then
                ClaimEvent:FireServer()
            end

            -- Stage
            teleportToStage(
                rootPart,
                i
            )

            -- Delay
            local waitTime = 2

            if i == 1
                and not isFirstAttempt
            then
                waitTime = 7
            end

            local completed =
                SafeWait(
                    waitTime,
                    humanoid,
                    character,
                    cycleId
                )

            if not completed then

                finishedAllStages = false
                break
            end

            if i == 1 then
                isFirstAttempt = false
            end

            --================================================
            -- GOLDEN CHEST
            --================================================

            if i == 3 then

                local chestTrigger =
                    GetChestTrigger()

                if chestTrigger then

                    if not IsCycleValid(
                        cycleId,
                        character,
                        humanoid,
                        rootPart
                    ) then

                        finishedAllStages = false
                        break
                    end

                    rootPart.CFrame =
                        chestTrigger.CFrame

                    local chestCompleted =
                        SafeWait(
                            0.5,
                            humanoid,
                            character,
                            cycleId
                        )

                    if not chestCompleted then

                        finishedAllStages = false
                        break
                    end
                end
            end
        end

        --====================================================
        -- KIỂM TRA CYCLE
        --====================================================

        if not getgenv().Farm then
            continue
        end

        if cycleId ~= FarmCycleId then
            continue
        end

        if player.Character ~= character then
            continue
        end

        if humanoid.Health <= 0 then
            continue
        end

        --====================================================
        -- HOÀN THÀNH
        --====================================================

        if finishedAllStages then

            -- Claim cuối
            if ClaimEvent then
                ClaimEvent:FireServer()
            end

            --================================================
            -- INSTANT RESPAWN
            --================================================

            if getgenv().InstantRespawn then

                local joinedTeam = false

                for _, team in ipairs(
                    Teams:GetChildren()
                ) do

                    if team:IsA("Team") then

                        local teamLeader =
                            team:FindFirstChild(
                                "TeamLeader"
                            )

                        if teamLeader
                            and (
                                teamLeader.Value == ""
                                or teamLeader.Value == nil
                            )
                        then

                            if ChangeTeamEvent then

                                ChangeTeamEvent:
                                    FireServer(team)

                                joinedTeam = true
                                break
                            end
                        end
                    end
                end

                -- Không tìm được team
                -- thì reset bình thường
                if not joinedTeam then

                    if humanoid.Health > 0 then
                        humanoid.Health = 0
                    end
                end

            --================================================
            -- NORMAL RESET
            --================================================

            else

                if humanoid.Health > 0 then
                    humanoid.Health = 0
                end
            end

            --================================================
            -- CHỜ CHARACTER CŨ BIẾN MẤT
            --================================================

            if getgenv().Farm then

                local oldCharacter =
                    character

                repeat
                    task.wait(0.1)
                until
                    not getgenv().Farm
                    or player.Character ~= oldCharacter
                    or not oldCharacter.Parent
            end
        end

        task.wait(0.1)
    end
end)

