--============================================================
-- CẬP NHẬT CHỈ SỐ UI & MISC LOGIC MỖI GIÂY
--============================================================
task.spawn(function()
    local zoneNames = {
        "WhiteZone", "BlackZone", "CamoZone", "MagentaZone", 
        "New YellerZone", "Really blueZone", "Really redZone"
    }

    while true do
        task.wait(1)
        
        -- 1. Cập nhật UI Vàng & Thời gian
        if goldObj then
            local currentGold = goldObj.Value
            local gainedGold = currentGold - initialGold
            local runTime = os.clock() - StartTime
            
            local goldPerHour = 0
            if runTime > 0 then
                goldPerHour = math.floor((gainedGold / runTime) * 3600)
            end

            Label1.Text = "Current Gold: " .. tostring(currentGold)
            Label2.Text = "Gold Gained: " .. tostring(gainedGold)
            Label3.Text = "Gold Per Hour: " .. tostring(goldPerHour) .. "/H"
        end
        
        if getgenv().farm then
            local elapsed = os.clock() - FarmStartTime
            local hours = math.floor(elapsed / 3600)
            local minutes = math.floor((elapsed % 3600) / 60)
            local seconds = math.floor(elapsed % 60)
            Label4.Text = string.format("Farm Time: %02d:%02d:%02d", hours, minutes, seconds)
        end
        
        -- 2. Xử lý Bypass Isolation
        if getgenv().bypassIsolation then
            for _, zoneName in ipairs(zoneNames) do
                local zone = Workspace:FindFirstChild(zoneName)
                if zone then
                    local lock = zone:FindFirstChild("Lock")
                    if lock then
                        local part = lock:FindFirstChild("Part")
                        if part then
                            part:Destroy()
                        end
                    end
                end
            end
        end
        
        -- 3. Xử lý Auto Join Team
        if getgenv().autoJoinTeam and selectedTeamToJoin then
            local targetTeam = Teams:FindFirstChild(selectedTeamToJoin)
            if targetTeam and player.Team ~= targetTeam then
                local leader = targetTeam:FindFirstChild("TeamLeader")
                if not leader or leader.Value == nil or leader.Value == "" then
                    local changeTeamEvent = Workspace:FindFirstChild("ChangeTeam")
                    if changeTeamEvent then
                        changeTeamEvent:FireServer(targetTeam)
                    end
                end
            end
        end
        
    end
end)

--============================================================
-- VÒNG LẶP FARM NGẦM (XỬ LÝ LOGIC)
--============================================================
task.spawn(function()
    while true do
        task.wait(0.1) 
        
        if getgenv().farm then
            local character = player.Character
            if not character or not character.Parent then continue end
            
            local humanoid = character:FindFirstChild("Humanoid")
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if not humanoid or humanoid.Health <= 0 or not rootPart then continue end

            local diedMidway = false

            -- Tiến trình Farm từ Stage 1 đến Stage 9
            for stage = 1, 9 do
                if not getgenv().farm then break end
                
                -- Kiểm tra liên tục: Nếu nhân vật chết hoặc mất giữa chừng thì ngắt loop
                if not character or not character.Parent or humanoid.Health <= 0 then
                    diedMidway = true
                    break
                end
                
                local targetZ = startZ + ((stage - 1) * studOffset)
                CreatePlatform(stage, startX, startY, targetZ)
                
                -- DỊCH CHUYỂN
                rootPart.CFrame = CFrame.new(startX, startY, targetZ)
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                -- THỜI GIAN CHỜ (Bỏ farm gold block, chỉ đợi thời gian bình thường)
                if stage == 1 then
                    if isFirstCycle then
                        task.wait(2) -- Lần đầu chờ 2 giây
                        isFirstCycle = false
                    else
                        task.wait(7) -- Các lần sau chờ 7 giây
                    end
                else
                    -- Stage 2 đến 9
                    task.wait(2)
                end
                
                -- Check lại trước khi Claim Gold
                if not character or not character.Parent or humanoid.Health <= 0 or not getgenv().farm then 
                    diedMidway = true
                    break 
                end
                
                ClaimGold()
            end
            
            if not getgenv().farm then continue end
            
            -- Nếu chết giữa chừng thì chỉ cần bỏ qua lần lặp này, vòng lặp while sẽ tự lấy character mới
            if diedMidway then
                task.wait(1)
                continue
            end
            
            --=========================================
            -- XỬ LÝ HỒI SINH (SAU KHI CLAIM STAGE 9 HOÀN TẤT)
            --=========================================
            local changedTeamSuccess = false
            
            if getgenv().instantRespawn then
                local emptyTeam = GetEmptyTeam()
                if emptyTeam then
                    local changeTeamEvent = Workspace:FindFirstChild("ChangeTeam")
                    if changeTeamEvent then
                        changeTeamEvent:FireServer(emptyTeam)
                        changedTeamSuccess = true
                    end
                end
            end
            
            if not changedTeamSuccess then
                if humanoid and humanoid.Health > 0 then
                    humanoid.Health = 0 
                end
            end
            
            -- Chờ một chút trước khi tìm character mới
            task.wait(1.5)
        end
    end
end)
