getgenv().Farm = false -- Bật/tắt biến toàn cục tại đây

local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local player = Players.LocalPlayer

local ClaimEvent = workspace:WaitForChild("ClaimRiverResultsGold")
local ChangeTeamEvent = workspace:WaitForChild("ChangeTeam")

local startPos = Vector3.new(-51.565643310546875, 90.00004577636719, 1369.090087890625)
local stageSize = Vector3.new(10, 1, 10)
local zOffset = 770
local totalStages = 9

--============================================================
-- DATA
--============================================================

local dataFolder = player:WaitForChild("Data", 10)

local Gold =
    dataFolder
    and dataFolder:WaitForChild("Gold", 10)

local GoldBlock =
    dataFolder
    and dataFolder:WaitForChild("GoldBlock", 10)

--============================================================
-- FARM
--============================================================

local FarmCycleId = 0
local isFirstAttempt = true

--============================================================
-- STATS
--============================================================

local InitialGold = 0
local InitialGoldBlock = 0

local FarmStartTime = 0

-- Lưu trạng thái Farm trước đó
local LastFarmState = false

--============================================================
-- REFRESH STATS
--============================================================

local function RefreshStats()

    InitialGold =
        Gold and Gold.Value or 0

    InitialGoldBlock =
        GoldBlock and GoldBlock.Value or 0
end

--============================================================
-- TẠO CÁC BỆ ĐỠ
--============================================================

local stageFolder =
    workspace:FindFirstChild("FarmStagesFolder")

if not stageFolder then

    stageFolder = Instance.new("Folder")
    stageFolder.Name = "FarmStagesFolder"
    stageFolder.Parent = workspace

    for i = 1, totalStages do

        local stage = Instance.new("Part")

        stage.Name = "stage" .. i
        stage.Size = stageSize
        stage.Anchored = true

        local currentPos =
            startPos
            + Vector3.new(
                0,
                0,
                (i - 1) * zOffset
            )

        stage.Position = currentPos
        stage.Parent = stageFolder
    end
end

--============================================================
-- LẤY EMPTY TEAM
--============================================================

local function GetEmptyTeam()

    for _, team in ipairs(
        Teams:GetChildren()
    ) do

        if team:IsA("Team") then

            local teamLeader =
                team:FindFirstChild(
                    "TeamLeader"
                )

            if teamLeader
                and (
                    teamLeader.Value == ""
                    or teamLeader.Value == nil
                )
            then
                return team
            end
        end
    end

    return nil
end

--============================================================
-- KIỂM TRA CYCLE
--============================================================

local function IsCycleValid(
    cycleId,
    character,
    humanoid,
    rootPart
)

    if not getgenv().Farm then
        return false
    end

    if cycleId ~= FarmCycleId then
        return false
    end

    if player.Character ~= character then
        return false
    end

    if not character
        or not character.Parent
    then
        return false
    end

    if not humanoid
        or not humanoid.Parent
        or humanoid.Health <= 0
    then
        return false
    end

    if not rootPart
        or not rootPart.Parent
    then
        return false
    end

    return true
end

--============================================================
-- SAFE WAIT
--============================================================

local function SafeWait(
    seconds,
    humanoid,
    character,
    cycleId
)

    local t = 0

    while t < seconds do

        if not getgenv().Farm then
            return false
        end

        if cycleId ~= FarmCycleId then
            return false
        end

        if player.Character ~= character then
            return false
        end

        if not humanoid
            or not humanoid.Parent
        then
            return false
        end

        if humanoid.Health <= 0 then
            return false
        end

        local dt =
            task.wait(0.1)

        t += dt
    end

    return true
end

--============================================================
-- TELEPORT STAGE
--============================================================

local function teleportToStage(
    rootPart,
    stage
)

    local targetPos =
        startPos
        + Vector3.new(
            0,
            0,
            (stage - 1) * zOffset
        )

    rootPart.CFrame =
        CFrame.new(
            targetPos
            + Vector3.new(0, 3, 0)
        )
end

--============================================================
-- LẤY GOLDEN CHEST TRIGGER
--============================================================

local function GetChestTrigger()

    local boatStages =
        workspace:FindFirstChild(
            "BoatStages"
        )

    local normalStages =
        boatStages
        and boatStages:FindFirstChild(
            "NormalStages"
        )

    local theEnd =
        normalStages
        and normalStages:FindFirstChild(
            "TheEnd"
        )

    local goldenChest =
        theEnd
        and theEnd:FindFirstChild(
            "GoldenChest"
        )

    return goldenChest
        and goldenChest:FindFirstChild(
            "Trigger"
        )
end

--============================================================
-- THEO DÕI CHARACTER DEATH
--============================================================

local function setupCharacter(character)

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        humanoid =
            character:WaitForChild(
                "Humanoid",
                10
            )
    end

    if humanoid then

        humanoid.Died:Connect(
            function()

                if getgenv().Farm then
                    FarmCycleId += 1
                end

            end
        )
    end
end

if player.Character then

    task.spawn(function()
        setupCharacter(
            player.Character
        )
    end)
end

player.CharacterAdded:Connect(
    function(character)

        task.spawn(function()
            setupCharacter(character)
        end)

    end
)

--============================================================
-- CHẠY FARM
--============================================================

task.spawn(function()

    while true do

        --====================================================
        -- FARM OFF
        --====================================================

        if not getgenv().Farm then

            task.wait(0.1)
            continue
        end

        --====================================================
        -- LẤY CHARACTER
        --====================================================

        local character =
            player.Character

        if not character then
            task.wait(0.1)
            continue
        end

        local rootPart =
            character:FindFirstChild(
                "HumanoidRootPart"
            )

        local humanoid =
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        if not rootPart
            or not humanoid
        then

            task.wait(0.1)
            continue
        end

        if humanoid.Health <= 0 then
            task.wait(0.1)
            continue
        end

        --====================================================
        -- CYCLE ID
        --====================================================

        local cycleId =
            FarmCycleId

        local finishedAllStages = true

        --====================================================
        -- 9 STAGES
        --====================================================

        for i = 1, totalStages do

            if not IsCycleValid(
                cycleId,
                character,
                humanoid,
                rootPart
            ) then

                finishedAllStages = false
                break
            end

            -- Claim
            if ClaimEvent then
                ClaimEvent:FireServer()
            end

            -- Stage
            teleportToStage(
                rootPart,
                i
            )

            -- Delay
            local waitTime = 2

            if i == 1
                and not isFirstAttempt
            then
                waitTime = 7
            end

            local waitCompleted =
                SafeWait(
                    waitTime,
                    humanoid,
                    character,
                    cycleId
                )

            if not waitCompleted then

                finishedAllStages = false
                break
            end

            if i == 1 then
                isFirstAttempt = false
            end

            --================================================
            -- GOLDEN CHEST
            --================================================

            if i == 3 then

                local chestTrigger =
                    GetChestTrigger()

                if chestTrigger then

                    if not IsCycleValid(
                        cycleId,
                        character,
                        humanoid,
                        rootPart
                    ) then

                        finishedAllStages = false
                        break
                    end

                    rootPart.CFrame =
                        chestTrigger.CFrame

                    local chestWaitCompleted =
                        SafeWait(
                            0.5,
                            humanoid,
                            character,
                            cycleId
                        )

                    if not chestWaitCompleted then

                        finishedAllStages = false
                        break
                    end
                end
            end
        end

        --====================================================
        -- KIỂM TRA SAU CYCLE
        --====================================================

        if not getgenv().Farm then
            continue
        end

        if cycleId ~= FarmCycleId then
            continue
        end

        if player.Character ~= character then
            continue
        end

        if humanoid.Health <= 0 then
            continue
        end

        --====================================================
        -- HOÀN THÀNH
        --====================================================

        if finishedAllStages then

            -- Claim cuối
            if ClaimEvent then
                ClaimEvent:FireServer()
            end

            -- Tìm team trống
            local joinedTeam = false

            for _, team in ipairs(
                Teams:GetChildren()
            ) do

                if team:IsA("Team") then

                    local teamLeader =
                        team:FindFirstChild(
                            "TeamLeader"
                        )

                    if teamLeader
                        and (
                            teamLeader.Value == ""
                            or teamLeader.Value == nil
                        )
                    then

                        if ChangeTeamEvent then

                            ChangeTeamEvent:
                                FireServer(team)

                            joinedTeam = true
                            break
                        end
                    end
                end
            end

            -- Không có team trống
            if not joinedTeam then

                if humanoid
                    and humanoid.Health > 0
                then
                    humanoid.Health = 0
                end
            end

            -- Chờ Character cũ biến mất
            if getgenv().Farm then

                local oldCharacter =
                    character

                repeat
                    task.wait(0.1)
                until
                    not getgenv().Farm
                    or player.Character ~= oldCharacter
                    or not oldCharacter.Parent
            end
        end

        task.wait(0.1)
    end
end)

