--============================================================
-- FARM CONFIG
--============================================================

Window:Separator({
    Text = "Farm Config"
})

Window:Checkbox({
    Label = "Auto Farm",
    Value = false,

    Callback = function(_, Value)

        local OldValue =
            getgenv().Farm

        getgenv().Farm =
            Value

        --====================================================
        -- BẬT FARM
        --====================================================

        if Value then

            -- Mỗi lần bật lại:
            -- reset Farm Time
            -- bắt đầu tính thời gian mới

            FarmStartTime =
                os.clock()

            LabelFarmTime.Text =
                "Farm Time: 00:00:00"

            -- Cycle mới
            FarmCycleId += 1

            -- Nếu trước đó đang false
            -- thì đây là một phiên farm mới
            if not OldValue then
                isFirstAttempt = true
            end

        --====================================================
        -- TẮT FARM
        --====================================================

        else

            -- Hủy cycle hiện tại
            FarmCycleId += 1

            -- Giữ Farm Time tại thời điểm tắt
            local elapsed =
                os.clock()
                - FarmStartTime

            local h =
                math.floor(
                    elapsed / 3600
                )

            local m =
                math.floor(
                    (elapsed % 3600) / 60
                )

            local s =
                math.floor(
                    elapsed % 60
                )

            LabelFarmTime.Text =
                string.format(
                    "Farm Time: %02d:%02d:%02d",
                    h,
                    m,
                    s
                )
        end
    end
})

