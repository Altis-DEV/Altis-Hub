--============================================================
-- CẬP NHẬT STATS MỖI 1 GIÂY
--============================================================

task.spawn(function()

    while true do

        task.wait(1)

        --====================================================
        -- CURRENT GOLD
        --====================================================

        local currentGold =
            Gold and Gold.Value or 0

        local currentGoldBlock =
            GoldBlock
            and GoldBlock.Value
            or 0

        --====================================================
        -- GAINED
        --====================================================

        local gainedGold =
            currentGold
            - InitialGold

        local gainedGoldBlock =
            currentGoldBlock
            - InitialGoldBlock

        --====================================================
        -- FARM TIME
        --====================================================

        local farmTime = 0

        if getgenv().Farm then

            -- Nếu vừa chuyển false -> true
            -- reset thời gian

            if not LastFarmState then

                FarmStartTime =
                    os.clock()

                farmTime = 0

            else

                farmTime =
                    os.clock()
                    - FarmStartTime
            end
        else

            -- Khi Farm tắt:
            -- giữ nguyên thời gian cuối cùng

            if LastFarmState then

                farmTime =
                    os.clock()
                    - FarmStartTime
            end
        end

        --====================================================
        -- PER HOUR
        --====================================================

        local goldPerHour = 0
        local goldBlockPerHour = 0

        if farmTime > 0 then

            goldPerHour =
                math.floor(
                    (
                        gainedGold
                        / farmTime
                    ) * 3600
                )

            goldBlockPerHour =
                math.floor(
                    (
                        gainedGoldBlock
                        / farmTime
                    ) * 3600
                )
        end

        --====================================================
        -- UPDATE LABELS
        --====================================================

        LabelCurrentGold.Text =
            "Current Gold: "
            .. tostring(currentGold)

        LabelCurrentGoldBlock.Text =
            "Current Gold Block: "
            .. tostring(currentGoldBlock)

        LabelGoldGained.Text =
            "Gold Gained: "
            .. tostring(gainedGold)

        LabelGoldBlockGained.Text =
            "Gold Block Gained: "
            .. tostring(gainedGoldBlock)

        LabelGoldPerHour.Text =
            "Gold Per Hour: "
            .. tostring(goldPerHour)
            .. "/H"

        LabelGoldBlockPerHour.Text =
            "Gold Block Per Hour: "
            .. tostring(goldBlockPerHour)
            .. "/H"

        --====================================================
        -- FARM TIME LABEL
        --====================================================

        local h =
            math.floor(
                farmTime / 3600
            )

        local m =
            math.floor(
                (farmTime % 3600) / 60
            )

        local s =
            math.floor(
                farmTime % 60
            )

        LabelFarmTime.Text =
            string.format(
                "Farm Time: %02d:%02d:%02d",
                h,
                m,
                s
            )

        -- Lưu trạng thái hiện tại
        LastFarmState =
            getgenv().Farm
    end
end)
