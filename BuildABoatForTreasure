local function ClaimGold()
    local Event = Workspace:FindFirstChild("ClaimRiverResultsGold")
    if Event then
        Event:FireServer()
    end
end

local function CreatePlatform(stage, x, y, z)
    local folder = Workspace:FindFirstChild("FarmPlatforms")
    if not folder then
        folder = Instance.new("Folder", Workspace)
        folder.Name = "FarmPlatforms"
    end

    local partName = "Stage_" .. stage
    local platform = folder:FindFirstChild(partName)
    
    if not platform then
        platform = Instance.new("Part")
        platform.Name = partName
        platform.Size = Vector3.new(10, 1, 10)
        platform.Anchored = true
        platform.Material = Enum.Material.Plastic
        platform.Transparency = 0.5
        platform.Position = Vector3.new(x, y - 3, z) 
        platform.Parent = folder
    end
end

local function GetEmptyTeam()
    local teamList = {"white", "red", "blue", "yellow", "black", "green", "magenta", "camo"}
    for _, teamName in ipairs(teamList) do
        local teamObj = Teams:FindFirstChild(teamName)
        if teamObj then
            local leaderValue = teamObj:FindFirstChild("TeamLeader")
            if not leaderValue or leaderValue.Value == nil or leaderValue.Value == "" then
                return teamObj 
            end
        end
    end
    return nil 
end

