task.spawn(function()
    local zoneNames = {
        "WhiteZone", "BlackZone", "CamoZone", "MagentaZone", 
        "New YellerZone", "Really blueZone", "Really redZone"
    }

    while true do
        task.wait(1)
        
        -- 1. Cập nhật UI Vàng, Gold Block & Thời gian
        if goldObj then
            local currentGold = goldObj.Value
            local gainedGold = currentGold - initialGold
            local runTime = os.clock() - StartTime
            
            local goldPerHour = 0
            if runTime > 0 then
                goldPerHour = math.floor((gainedGold / runTime) * 3600)
            end

            Label1.Text = "Current Gold: " .. tostring(currentGold)
            Label2.Text = "Gold Gained: " .. tostring(gainedGold)
            Label3.Text = "Gold Per Hour: " .. tostring(goldPerHour) .. "/H"
        end

        if goldBlockObj then
            local currentGoldBlock = goldBlockObj.Value
            local gainedGoldBlock = currentGoldBlock - initialGoldBlock
            LabelGoldBlock.Text = "Gold Block Gained: " .. tostring(gainedGoldBlock)
        end
        
        if getgenv().farm then
            local elapsed = os.clock() - FarmStartTime
            local hours = math.floor(elapsed / 3600)
            local minutes = math.floor((elapsed % 3600) / 60)
            local seconds = math.floor(elapsed % 60)
            Label4.Text = string.format("Farm Time: %02d:%02d:%02d", hours, minutes, seconds)
        end
        
        -- 2. Xử lý Bypass Isolation
        if getgenv().bypassIsolation then
            for _, zoneName in ipairs(zoneNames) do
                local zone = Workspace:FindFirstChild(zoneName)
                if zone then
                    local lock = zone:FindFirstChild("Lock")
                    if lock then
                        local part = lock:FindFirstChild("Part")
                        if part then
                            part:Destroy()
                        end
                    end
                end
            end
        end
        
        -- 3. Xử lý Auto Join Team
        if getgenv().autoJoinTeam and selectedTeamToJoin then
            local targetTeam = Teams:FindFirstChild(selectedTeamToJoin)
            if targetTeam and player.Team ~= targetTeam then
                local leader = targetTeam:FindFirstChild("TeamLeader")
                if not leader or leader.Value == nil or leader.Value == "" then
                    local changeTeamEvent = Workspace:FindFirstChild("ChangeTeam")
                    if changeTeamEvent then
                        changeTeamEvent:FireServer(targetTeam)
                    end
                end
            end
        end
        
    end
end)

--============================================================
-- VÒNG LẶP FARM NGẦM (XỬ LÝ LOGIC)
--============================================================
task.spawn(function()
    while true do
        task.wait(0.1) 
        
        if getgenv().farm then
            local character = player.Character
            if not character or not character.Parent then continue end
            
            local humanoid = character:FindFirstChild("Humanoid")
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if not humanoid or humanoid.Health <= 0 or not rootPart then continue end

            -- VỪA RESPAWN: Claim Gold ngay lập tức để vét sạch vàng thừa trước khi dịch chuyển
            ClaimGold()
            task.wait(0.2)
            
            -- Kiểm tra lại character sau khi wait
            if not character or not character.Parent or humanoid.Health <= 0 or not rootPart then continue end

            local diedMidway = false

            --=============================================
            -- CHẾ ĐỘ FARM: GOLD BLOCK
            --=============================================
            if getgenv().farmMode == "gold block" then
                local targetZ = startZ
                CreatePlatform(1, startX, startY, targetZ)
                
                -- BƯỚC 1: Đưa nhân vật ra vị trí Stage 1
                rootPart.CFrame = CFrame.new(startX, startY, targetZ)
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                
                if isFirstCycle then
                    task.wait(2)
                    isFirstCycle = false
                else
                    task.wait(7)
                end
                
                if not character or not character.Parent or humanoid.Health <= 0 or not getgenv().farm then continue end

                -- BƯỚC 2: Teleport đến Trigger (Rương Vàng)
                local chestTrigger
                pcall(function()
                    chestTrigger = Workspace.BoatStages.NormalStages.TheEnd.GoldenChest.Trigger
                end)

                if chestTrigger then
                    rootPart.CFrame = CFrame.new(chestTrigger.Position)
                    task.wait(0.1)
                end
                
                if not character or not character.Parent or humanoid.Health <= 0 or not getgenv().farm then continue end

                -- BƯỚC 3: Trở về vị trí Stage 1 và đợi 10 giây
                rootPart.CFrame = CFrame.new(startX, startY, targetZ)
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                
                task.wait(10)
                
                if not character or not character.Parent or humanoid.Health <= 0 or not getgenv().farm then continue end

                -- BƯỚC 4: Claim Gold
                ClaimGold()

            --=============================================
            -- CHẾ ĐỘ FARM: GOLD HOẶC BOTH
            --=============================================
            elseif getgenv().farmMode == "gold" or getgenv().farmMode == "both" then
                for stage = 1, 9 do
                    if not getgenv().farm then break end
                    
                    if not character or not character.Parent or humanoid.Health <= 0 then
                        diedMidway = true
                        break
                    end
                    
                    local targetZ = startZ + ((stage - 1) * studOffset)
                    CreatePlatform(stage, startX, startY, targetZ)
                    
                    -- DỊCH CHUYỂN
                    rootPart.CFrame = CFrame.new(startX, startY, targetZ)
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                    -- THỜI GIAN CHỜ
                    if stage == 1 then
                        if isFirstCycle then
                            task.wait(2)
                            isFirstCycle = false
                        else
                            task.wait(7)
                        end
                    else
                        task.wait(2)
                    end
                    
                    if not character or not character.Parent or humanoid.Health <= 0 or not getgenv().farm then 
                        diedMidway = true
                        break 
                    end

                    -- LOGIC RIÊNG CHO CHẾ ĐỘ "BOTH" TẠI STAGE 3
                    if getgenv().farmMode == "both" and stage == 3 then
                        local chestTrigger
                        pcall(function()
                            chestTrigger = Workspace.BoatStages.NormalStages.TheEnd.GoldenChest.Trigger
                        end)

                        if chestTrigger then
                            -- Teleport đến trigger
                            rootPart.CFrame = CFrame.new(chestTrigger.Position)
                            task.wait(0.1)
                            
                            -- Trở về lại Stage 3
                            rootPart.CFrame = CFrame.new(startX, startY, targetZ)
                            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        end
                    end
                    
                    -- Check lại trước khi Claim Gold
                    if not character or not character.Parent or humanoid.Health <= 0 or not getgenv().farm then 
                        diedMidway = true
                        break 
                    end
                    
                    ClaimGold()
                end
                
                if diedMidway or not getgenv().farm then
                    task.wait(1)
                    continue
                end
            end
            
            -- Tránh thực hiện logic reset khi Auto Farm vừa bị tắt
            if not getgenv().farm then continue end
            
            --=========================================
            -- XỬ LÝ HỒI SINH & RESET (Dùng chung)
            --=========================================
            local changedTeamSuccess = false
            
            if getgenv().instantRespawn then
                local emptyTeam = GetEmptyTeam()
                if emptyTeam then
                    local changeTeamEvent = Workspace:FindFirstChild("ChangeTeam")
                    if changeTeamEvent then
                        changeTeamEvent:FireServer(emptyTeam)
                        changedTeamSuccess = true
                    end
                end
            end
            
            if not changedTeamSuccess then
                if humanoid and humanoid.Health > 0 then
                    humanoid.Health = 0 
                end
            end
            
            -- Chờ một chút trước khi tìm character mới (cho vòng lặp tiếp theo)
            task.wait(1.5)
        end
    end
end)
