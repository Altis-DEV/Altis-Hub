--============================================================
-- KHỞI TẠO BIẾN TOÀN CỤC & DỊCH VỤ
--============================================================
getgenv().farm = false 
getgenv().instantRespawn = false 

local isFirstCycle = true 

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Teams = game:GetService("Teams")
local player = Players.LocalPlayer

local dataFolder = player:WaitForChild("Data", 10)
local goldObj = dataFolder and dataFolder:WaitForChild("Gold", 10)
local initialGold = goldObj and goldObj.Value or 0
local StartTime = os.clock()
local FarmStartTime = 0 -- Biến lưu thời gian bắt đầu farm

--============================================================
-- THIẾT LẬP THÔNG SỐ FARM & HÀM PHỤ TRỢ
--============================================================
local startX = -51.565643310546875
local startY = 90.00004577636719
local startZ = 1369.090087890625
local studOffset = 770

local function ClaimGold()
    local Event = Workspace:FindFirstChild("ClaimRiverResultsGold")
    if Event then
        Event:FireServer()
    end
end

local function CreatePlatform(stage, x, y, z)
    local folder = Workspace:FindFirstChild("FarmPlatforms")
    if not folder then
        folder = Instance.new("Folder", Workspace)
        folder.Name = "FarmPlatforms"
    end

    local partName = "Stage_" .. stage
    local platform = folder:FindFirstChild(partName)
    
    if not platform then
        platform = Instance.new("Part")
        platform.Name = partName
        platform.Size = Vector3.new(10, 1, 10)
        platform.Anchored = true
        platform.Material = Enum.Material.Plastic
        platform.Transparency = 0.5
        platform.Position = Vector3.new(x, y - 3, z) 
        platform.Parent = folder
    end
end

-- Hàm tìm Team trống
local function GetEmptyTeam()
    local teamList = {"white", "red", "blue", "yellow", "black", "green", "magenta"}
    
    for _, teamName in ipairs(teamList) do
        local teamObj = Teams:FindFirstChild(teamName)
        if teamObj then
            local leaderValue = teamObj:FindFirstChild("TeamLeader")
            if not leaderValue or leaderValue.Value == nil or leaderValue.Value == "" then
                return teamObj 
            end
        end
    end
    
    return nil 
end

