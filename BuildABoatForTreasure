local function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getRootHumanoid()
    local character = getCharacter()
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    return character, rootPart, humanoid
end

local function enableNoClip(flagName)
    return RunService.Stepped:Connect(function()
        if getgenv()[flagName] and LocalPlayer.Character then
            for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function waitUntil(seconds, flagName)
    local start = os.clock()
    while os.clock() - start < seconds do
        if not getgenv()[flagName] then
            return false
        end
        task.wait()
    end
    return true
end

local function waitForRespawnAndDelay(oldCharacter, flagName)
    while getgenv()[flagName] and LocalPlayer.Character == oldCharacter do
        task.wait()
    end

    if not getgenv()[flagName] then
        return false
    end

    task.wait(5)
    return true
end

local function runTweenStep(step, flagName, expectedCharacter)
    if not getgenv()[flagName] then
        return false
    end

    local character, rootPart, humanoid = getRootHumanoid()
    if not character or character ~= expectedCharacter or not rootPart or not humanoid or humanoid.Health <= 0 then
        return false
    end

    local antiFall = Instance.new("BodyVelocity")
    antiFall.Velocity = Vector3.new(0, 0, 0)
    antiFall.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    antiFall.Parent = rootPart

    local distance = (rootPart.Position - step.Position).Magnitude
    local duration = math.max(distance / 200, 0.05)

    local tween = TweenService:Create(
        rootPart,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        { CFrame = CFrame.new(step.Position) }
    )

    local done = false
    local conn
    conn = tween.Completed:Connect(function()
        done = true
    end)

    tween:Play()

    while not done do
        if not getgenv()[flagName] or LocalPlayer.Character ~= expectedCharacter or humanoid.Health <= 0 then
            tween:Cancel()
            break
        end
        task.wait()
    end

    if conn then conn:Disconnect() end
    antiFall:Destroy()

    return getgenv()[flagName] and LocalPlayer.Character == expectedCharacter and humanoid.Health > 0
end

local function runTeleportStep(step, flagName, expectedCharacter, rootPart)
    if not getgenv()[flagName] then
        return false
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not character or character ~= expectedCharacter or not rootPart or not humanoid or humanoid.Health <= 0 then
        return false
    end

    rootPart.Velocity = Vector3.new(0, 0, 0)
    rootPart.CFrame = CFrame.new(step.Position)

    if step.Wait and step.Wait > 0 then
        if not waitUntil(step.Wait, flagName) then
            return false
        end
    else
        task.wait(0.05)
    end

    return getgenv()[flagName] and LocalPlayer.Character == expectedCharacter and humanoid.Health > 0
end

local function startTweenFarm(flagName, route, resetDelay)
    State.RunToken += 1
    local token = State.RunToken

    task.spawn(function()
        while token == State.RunToken and getgenv()[flagName] do
            local noclipConn = enableNoClip(flagName)

            local character, _, humanoid = getRootHumanoid()
            if not character or not humanoid then
                if noclipConn then noclipConn:Disconnect() end
                task.wait(0.5)
                continue
            end

            local runCharacter = character
            local aborted = false

            for _, step in ipairs(route) do
                if token ~= State.RunToken or not getgenv()[flagName] then
                    aborted = true
                    break
                end

                if LocalPlayer.Character ~= runCharacter or humanoid.Health <= 0 then
                    aborted = true
                    break
                end

                if not runTweenStep(step, flagName, runCharacter) then
                    aborted = true
                    break
                end
            end

            if noclipConn then
                noclipConn:Disconnect()
            end

            if token ~= State.RunToken or not getgenv()[flagName] then
                break
            end

            if aborted or LocalPlayer.Character ~= runCharacter or humanoid.Health <= 0 then
                if not waitForRespawnAndDelay(runCharacter, flagName) then
                    break
                end
                continue
            end

            if resetDelay and resetDelay > 0 then
                if not waitUntil(resetDelay, flagName) then
                    break
                end
            end

            if humanoid and humanoid.Health > 0 then
                humanoid.Health = 0
            end

            if not waitForRespawnAndDelay(runCharacter, flagName) then
                break
            end
        end
    end)
end

local function startTeleportFarm(flagName, route, resetDelay)
    State.RunToken += 1
    local token = State.RunToken

    task.spawn(function()
        while token == State.RunToken and getgenv()[flagName] do
            local noclipConn = enableNoClip(flagName)

            local character, rootPart, humanoid = getRootHumanoid()
            if not character or not rootPart or not humanoid then
                if noclipConn then noclipConn:Disconnect() end
                task.wait(0.5)
                continue
            end

            local runCharacter = character
            local floatForce = Instance.new("BodyVelocity")
            floatForce.Name = "AltisFloatForce"
            floatForce.Velocity = Vector3.new(0, 0, 0)
            floatForce.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            floatForce.Parent = rootPart

            local aborted = false

            for _, step in ipairs(route) do
                if token ~= State.RunToken or not getgenv()[flagName] then
                    aborted = true
                    break
                end

                if LocalPlayer.Character ~= runCharacter or humanoid.Health <= 0 then
                    aborted = true
                    break
                end

                if not runTeleportStep(step, flagName, runCharacter, rootPart) then
                    aborted = true
                    break
                end
            end

            if noclipConn then
                noclipConn:Disconnect()
            end

            if floatForce then
                floatForce:Destroy()
            end

            if token ~= State.RunToken or not getgenv()[flagName] then
                break
            end

            if aborted or LocalPlayer.Character ~= runCharacter or humanoid.Health <= 0 then
                if not waitForRespawnAndDelay(runCharacter, flagName) then
                    break
                end
                continue
            end

            if resetDelay and resetDelay > 0 then
                if not waitUntil(resetDelay, flagName) then
                    break
                end
            end

            if humanoid and humanoid.Health > 0 then
                character:BreakJoints()
            end

            if not waitForRespawnAndDelay(runCharacter, flagName) then
                break
            end
        end
    end)
end

