-- GIAO DIỆN (WINDOW & ELEMENTS)
--============================================================
local Window = ReGui:Window({
    Title = "Altis Hub - Build A Boat For Treasure Auto Gold",
    Size = UDim2.fromOffset(300, 230)
}):Center()

local Label1 = Window:Label({ Text = "Current Gold: " .. tostring(initialGold) })
local Label2 = Window:Label({ Text = "Gold Earned: 0" })
local Label3 = Window:Label({ Text = "Gold Per Hour: 0/H" })

local Toggle1 = Window:Checkbox({
    Label = "Bật Auto Farm",
    Value = getgenv().farm,
    Callback = function(_, Value)
        getgenv().farm = Value
        if Value then
            isFirstCycle = true 
        end
    end
})

local Toggle2 = Window:Checkbox({
    Label = "Hồi Sinh Tức Thì (Đổi Team)",
    Value = getgenv().instantRespawn,
    Callback = function(_, Value)
        getgenv().instantRespawn = Value
    end
})

--============================================================
-- CẬP NHẬT CHỈ SỐ UI MỖI GIÂY
--============================================================
task.spawn(function()
    while true do
        task.wait(1)
        if goldObj then
            local currentGold = goldObj.Value
            local earnedGold = currentGold - initialGold
            local runTime = os.clock() - StartTime
            
            local goldPerHour = 0
            if runTime > 0 then
                goldPerHour = math.floor((earnedGold / runTime) * 3600)
            end

            Label1.Text = "Current Gold: " .. tostring(currentGold)
            Label2.Text = "Gold Earned: " .. tostring(earnedGold)
            Label3.Text = "Gold Per Hour: " .. tostring(goldPerHour) .. "/H"
        end
    end
end)

--============================================================
-- VÒNG LẶP FARM NGẦM (XỬ LÝ LOGIC)
--============================================================
task.spawn(function()
    while true do
        task.wait(0.1) 
        
        if getgenv().farm then
            local character = player.Character or player.CharacterAdded:Wait()
            local rootPart = character:WaitForChild("HumanoidRootPart", 5)
            local humanoid = character:WaitForChild("Humanoid", 5)
            
            if not (rootPart and humanoid) then continue end

            -- Chỉ đợi 5 giây nếu không phải cycle đầu tiên
            if not isFirstCycle then
                for i = 1, 5 do
                    if not getgenv().farm then break end
                    task.wait(1)
                end
            end
            
            isFirstCycle = false
            
            if not getgenv().farm then continue end

            -- Tiến trình 10 Stage
            for stage = 1, 10 do
                if not getgenv().farm then break end
                
                local targetZ = startZ + ((stage - 1) * studOffset)
                CreatePlatform(stage, startX, startY, targetZ)
                
                if rootPart and rootPart.Parent then
                    rootPart.CFrame = CFrame.new(startX, startY, targetZ)
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                end
                
                task.wait(1)
                if not getgenv().farm then break end
                
                ClaimGold()
                
                if stage < 10 then
                    task.wait(1)
                end
            end
            
            if not getgenv().farm then continue end
            
            --=========================================
            -- XỬ LÝ HỒI SINH (SAU KHI XONG STAGE 10)
            --=========================================
            local changedTeamSuccess = false
            
            if getgenv().instantRespawn then
                local emptyTeam = GetEmptyTeam()
                if emptyTeam then
                    local changeTeamEvent = Workspace:FindFirstChild("ChangeTeam")
                    if changeTeamEvent then
                        -- Bắn remote để chuyển sang team trống
                        changeTeamEvent:FireServer(emptyTeam)
                        changedTeamSuccess = true
                    end
                end
            end
            
            -- Fallback: Nếu không bật Hồi Sinh Tức Thì hoặc KHÔNG CÓ team nào trống
            if not changedTeamSuccess then
                if humanoid then
                    humanoid.Health = 0 
                end
            end
            
            -- Đợi game tạo nhân vật mới (dù là do đổi team hay chết thì vẫn sẽ chạy lệnh này)
            player.CharacterAdded:Wait()
        end
    end
end)
