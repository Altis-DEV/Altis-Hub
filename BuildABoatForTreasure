local function setupCharacter(character)

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not humanoid then
        humanoid =
            character:WaitForChild(
                "Humanoid",
                10
            )
    end

    if humanoid then

        humanoid.Died:Connect(
            function()

                if getgenv().Farm then
                    FarmCycleId += 1
                end

            end
        )
    end
end

if player.Character then

    task.spawn(function()
