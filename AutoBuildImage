local function createInput(name, placeholder, posY, defaultText)
    local TextBox = Instance.new("TextBox")
    TextBox.Name = name
    TextBox.Size = UDim2.new(0.9, 0, 0, 30)
    TextBox.Position = UDim2.new(0.05, 0, 0, posY)
    TextBox.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
    TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextBox.PlaceholderText = placeholder
    TextBox.Text = defaultText
    TextBox.Font = Enum.Font.Gotham
    TextBox.TextSize = 13
    TextBox.ClearTextOnFocus = false
    TextBox.TextWrapped = false 
    TextBox.TextTruncate = Enum.TextTruncate.AtEnd 
    TextBox.Parent = MainFrame
    Instance.new("UICorner", TextBox).CornerRadius = UDim.new(0, 5)
    return TextBox
end

