-- ========================================================
-- 1. BỘ GIẢI MÃ ẢNH BMP
-- ========================================================
local function DecodeBMP(bmpData)
    local offset = string.unpack("<I4", bmpData, 11)
    local width  = string.unpack("<i4", bmpData, 19)
    local height = string.unpack("<i4", bmpData, 23)
    local bpp    = string.unpack("<I2", bmpData, 29)
    
    if bpp ~= 24 and bpp ~= 32 then return nil, "Chỉ hỗ trợ BMP 24/32bit" end

    local pixels = {}
    local rowBytes = math.floor((bpp * width + 31) / 32) * 4 

    for y = 0, height - 1 do
        pixels[y + 1] = {}
        local rowOffset = offset + (height - 1 - y) * rowBytes + 1
        for x = 0, width - 1 do
            local byteOffset = rowOffset + x * (bpp / 8)
            local b, g, r
            if bpp == 24 then
                b, g, r = string.unpack("BBB", bmpData, byteOffset)
            else
                b, g, r, _ = string.unpack("BBBB", bmpData, byteOffset)
            end
            pixels[y + 1][x + 1] = Color3.fromRGB(r, g, b)
        end
    end
    return width, height, pixels
end

