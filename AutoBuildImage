-- ========================================================
-- 3. CẤU HÌNH SIÊU TỐC (TWEAK PARAMETERS)
-- ========================================================
local WORKER_THREADS = 60  -- Số lượng luồng gửi song song (Mặc định cũ là tạo vô hạn, giờ gom về 60 để tối ưu băng thông CPU)
local MAX_PRESSURE = 350   -- Nâng hạn mức van điều áp từ 150 lên 350 khối giúp đẩy nhanh tiến độ mạng khi có Ping cao

-- ========================================================
-- 4. LOGIC XỬ LÝ CHÍNH
-- ========================================================
BuildButton.MouseButton1Click:Connect(function()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    local blockFolder = workspace.Blocks:FindFirstChild(player.Name)
    if not blockFolder then StatusText.Text = "❌ Không tìm thấy Plot!" return end

    local ROWS = tonumber(RowInput.Text) or 8
    local COLUMNS = tonumber(ColInput.Text) or 8
    local TOTAL_BLOCKS = ROWS * COLUMNS
    local BLOCK_SIZE = tonumber(SizeInput.Text) or 2
    local BMP_URL = UrlInput.Text
    local useImage = BMP_URL ~= ""
    local newSizeVec = Vector3.new(BLOCK_SIZE, BLOCK_SIZE, BLOCK_SIZE)

    -- Xác định xem hệ thống có cần bật Radar kiểm soát không
    local needRadar = (BLOCK_SIZE ~= 2) or useImage

    local buildTool = player.Backpack:FindFirstChild("BuildingTool") or character:FindFirstChild("BuildingTool")
    local scaleTool = player.Backpack:FindFirstChild("ScalingTool") or character:FindFirstChild("ScalingTool")
    local paintTool = player.Backpack:FindFirstChild("PaintingTool") or character:FindFirstChild("PaintingTool")

    if not buildTool or (BLOCK_SIZE ~= 2 and not scaleTool) then StatusText.Text = "❌ Thiếu Tool cần thiết!" return end
    if useImage and not paintTool then StatusText.Text = "❌ Thiếu Sơn để tô màu!" return end

    buildTool.Parent = character
    if scaleTool then scaleTool.Parent = character end
    if useImage then paintTool.Parent = character end

    local buildRemote = buildTool:WaitForChild("RF")
    local scaleRemote = scaleTool and scaleTool:WaitForChild("RF") or nil
    local paintRemote = useImage and paintTool:WaitForChild("RF") or nil

    local imgWidth, imgHeight, ImageMatrix
    if useImage then
        StatusText.Text = "⏳ Đang tải ảnh..."
        local success, response = pcall(function() return game:HttpGetAsync(BMP_URL) end)
        if not success then StatusText.Text = "❌ Lỗi: Link ảnh không hợp lệ!" return end
        
        imgWidth, imgHeight, ImageMatrix = DecodeBMP(response)
        if not ImageMatrix then StatusText.Text = "❌ Lỗi: Không phải BMP!" return end
    end

    BuildButton.Text = "ĐANG XỬ LÝ..."
    BuildButton.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
    BuildButton.AutoButtonColor = false

    local look = rootPart.CFrame.LookVector
    local snapLook = math.abs(look.X) > math.abs(look.Z) and Vector3.new(math.sign(look.X), 0, 0) or Vector3.new(0, 0, math.sign(look.Z))
    local rawStartPos = rootPart.Position + (snapLook * 15)
    local startPos = Vector3.new(math.round(rawStartPos.X / BLOCK_SIZE) * BLOCK_SIZE, math.round(rawStartPos.Y / BLOCK_SIZE) * BLOCK_SIZE, math.round(rawStartPos.Z / BLOCK_SIZE) * BLOCK_SIZE)
    local baseCFrame = CFrame.lookAt(startPos, startPos + snapLook)

    local paintQueue = {}
    local processedCount = 0

    -- ========================================================
    -- CHẾ ĐỘ NÂNG CẤP: RADAR QUÉT KHỐI (CHỈ BẬT KHI CẦN)
    -- ========================================================
    local connection
    if needRadar then
        connection = blockFolder.ChildAdded:Connect(function(newBlock)
            if newBlock:IsA("Model") and (newBlock.Name == "PlasticBlock" or newBlock.Name:match("Block")) then
                task.spawn(function()
                    local pivot = newBlock:GetPivot()
                    local localPos = baseCFrame:ToObjectSpace(pivot).Position
                    local c = math.floor(localPos.X / BLOCK_SIZE + 0.5)
                    local r = math.floor(localPos.Y / BLOCK_SIZE + 0.5)
                    
                    if c >= 0 and c < COLUMNS and r >= 0 and r < ROWS then
                        -- Chỉ scale nếu kích thước khác mặc định (khác 2)
                        if BLOCK_SIZE ~= 2 and scaleRemote then
                            pcall(function() scaleRemote:InvokeServer(newBlock, newSizeVec, pivot) end)
                        end
                        
                        -- Chỉ gom màu nếu có ảnh
                        if useImage and ImageMatrix then
                            local sampleX = math.clamp(math.floor((c / COLUMNS) * imgWidth) + 1, 1, imgWidth)
                            local sampleY = math.clamp(math.floor(((ROWS - 1 - r) / ROWS) * imgHeight) + 1, 1, imgHeight)
                            local color = ImageMatrix[sampleY][sampleX]
                            
                            table.insert(paintQueue, {newBlock, color})
                            if #paintQueue >= 100 then
                                local currentQueue = paintQueue
                                paintQueue = {}
                                task.spawn(function() pcall(function() paintRemote:InvokeServer(currentQueue) end) end)
                            end
                        end
                        processedCount = processedCount + 1
                    end
                end)
            end
        end)
    end

    -- ========================================================
    -- THIẾT KẾ MỚI: HÀNG ĐỢI XÂY DỰNG & BỂ CHỨA CÔNG NHÂN (WORKER POOL)
    -- ========================================================
    local buildQueue = {}
    for r = 0, ROWS - 1 do
        for c = 0, COLUMNS - 1 do
            table.insert(buildQueue, baseCFrame * CFrame.new(c * BLOCK_SIZE, r * BLOCK_SIZE, 0))
        end
    end

    StatusText.Text = "🚀 Đang kích nổ luồng xây..."
    local queueIndex = 1
    local blockValue = player.Data.PlasticBlock.Value

    -- Tạo ra số lượng Worker cố định chạy song song rút việc từ hàng đợi
    for i = 1, WORKER_THREADS do
        task.spawn(function()
            while queueIndex <= TOTAL_BLOCKS do
                -- Áp dụng van điều áp động (Chỉ kích hoạt nếu cần kiểm soát Scale/Sơn)
                if needRadar then
                    while (queueIndex - processedCount) > MAX_PRESSURE do
                        task.wait(0.01) -- Đợi cực ngắn để đồng bộ mạng
                    end
                end

                local targetCFrame = buildQueue[queueIndex]
                if not targetCFrame then break end
                queueIndex = queueIndex + 1 -- Chuyển sang khối tiếp theo (Atomic pointer)

                -- Bắn lệnh tạo khối thẳng lên Server
                pcall(function()
                    buildRemote:InvokeServer("PlasticBlock", blockValue, nil, nil, true, targetCFrame, false)
                end)
            end
        end)
    end

    -- ========================================================
    -- BỘ GIÁM SÁT TIẾN ĐỘ
    -- ========================================================
    if needRadar then
        local stuckTimer = 0
        local lastCount = 0
        while processedCount < TOTAL_BLOCKS do
            StatusText.Text = "⏳ Tiến độ xử lý: " .. processedCount .. "/" .. TOTAL_BLOCKS
            task.wait(0.2)
            if processedCount == lastCount then
                stuckTimer = stuckTimer + 0.2
                if stuckTimer >= 6 then break end
            else
                stuckTimer = 0
                lastCount = processedCount
            end
        end
        if connection then connection:Disconnect() end
        if useImage and #paintQueue > 0 then
            pcall(function() paintRemote:InvokeServer(paintQueue) end)
        end
    else
        -- Chế độ Siêu Tốc Thuần Túy: Chỉ đợi hàng đợi rỗng, bỏ qua đồng bộ lag
        while queueIndex <= TOTAL_BLOCKS do
            StatusText.Text = "⚡ Đang bắn khối: " .. queueIndex .. "/" .. TOTAL_BLOCKS
            task.wait(0.1)
        end
        task.wait(0.5) -- Đợi Server cập nhật nốt các gói cuối
    end

    StatusText.Text = "✅ ĐÃ XÂY XONG HOÀN TOÀN!"
    BuildButton.Text = "XÂY DỰNG TỐC ĐỘ CAO"
    BuildButton.BackgroundColor3 = Color3.fromRGB(40, 200, 100)
    BuildButton.AutoButtonColor = true
end)
