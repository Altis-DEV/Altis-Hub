-- FETCH CHAT & ROLE OBSERVER
---------------------------------------------------
local function fetchRoutine(path, processFunc, startT)
    local res = http_request({Url = FIREBASE_URL .. path .. '?orderBy="$key"&limitToLast=20', Method = "GET"})
    if not res or res.StatusCode ~= 200 then return end
    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok or type(data) ~= "table" then return end

    local newMessages = {}
    for k, v in pairs(data) do
        if type(v) == "table" and v.timestamp and v.timestamp >= startT then table.insert(newMessages, {key = k, msg = v}) end
    end
    table.sort(newMessages, function(a, b) return a.msg.timestamp < b.msg.timestamp end)
    for _, item in ipairs(newMessages) do processFunc(item.key, item.msg) end
end

local function fetchChat()
    if isBanned then return end
    fetchRoutine(PATH_CHAT, addMessage, startTime)
    fetchRoutine(PATH_ADMINCHAT, addAdminMessage, adminStartTime)
end

local function checkRoleObserver()
    local myLiveRole = getRole(LocalPlayer.Name)
    if myLiveRole ~= lastMyRole then
        if (myLiveRole == "OWNER" or myLiveRole == "ADMIN") and lastMyRole == "USER" then
            createAdminTabs()
            Window:SendNotification("Nâng Cấp Quyền", "Bạn đã được cấp quyền quản trị. Đã mở Tab Admin!", 5)
        elseif myLiveRole == "USER" and (lastMyRole == "OWNER" or lastMyRole == "ADMIN") then
            destroyAdminTabs()
            Window:SendNotification("Hạ Quyền", "Bạn đã bị giáng xuống User. Đã đóng Tab Admin!", 5)
        end
        lastMyRole = myLiveRole
        
        for uid, obj in pairs(onlineObjects) do safelyDestroy(obj.p) end
        onlineObjects = {}
    end
end

