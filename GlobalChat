local function checkBanStatus()
    local res = http_request({Url = FIREBASE_URL .. PATH_BAN .. myHWID .. ".json", Method = "GET"})
    if res and res.StatusCode == 200 and res.Body == "true" then
        isBanned = true; running = false; LocalPlayer:Kick("bạn đã bị ban khỏi script")
    end
end

local function updateOnlineStatus()
    if isBanned then return end
    task.spawn(function()
        http_request({
            Url = FIREBASE_URL .. PATH_ONLINE .. LocalPlayer.UserId .. ".json", Method = "PUT",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({ displayName = LocalPlayer.DisplayName, username = LocalPlayer.Name, hwid = myHWID, timestamp = os.time() })
        })
    end)

    local res = http_request({Url = FIREBASE_URL .. "globalchat/online.json", Method = "GET"})
    if not res or res.StatusCode ~= 200 then return end
    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok or type(data) ~= "table" then data = {} end

    local newOnline, ownerCount, adminCount, userCount = {}, 0, 0, 0
    for userId, user in pairs(data) do
        if type(user) == "table" and user.timestamp then
            if os.time() - user.timestamp <= 15 then
                newOnline[userId] = user
                local role = getRole(user.username)
                if role == "OWNER" then ownerCount = ownerCount + 1
                elseif role == "ADMIN" then adminCount = adminCount + 1
                else userCount = userCount + 1 end
            else
                task.spawn(function() http_request({Url = FIREBASE_URL .. PATH_ONLINE .. userId .. ".json", Method = "DELETE"}) end)
            end
        end
    end

    currentOnline = newOnline
    lblOwnerCount:SetText("[OWNER] - " .. ownerCount .. " online")
    lblAdminCount:SetText("[ADMIN] - " .. adminCount .. " online")
    lblUserCount:SetText("User - " .. userCount .. " online")

    local myLiveRole = getRole(LocalPlayer.Name)

    for userId, user in pairs(currentOnline) do
        local userRole = getRole(user.username)
        local obj = onlineObjects[userId]
        
        if obj and obj.role ~= userRole then
            safelyDestroy(obj.p)
            onlineObjects[userId] = nil
            obj = nil
        end
        
        if not onlineObjects[userId] then
            local formatName = user.displayName .. " (@" .. user.username .. ")"
            if myLiveRole == "OWNER" or myLiveRole == "ADMIN" then formatName = formatName .. "\n[HWID: " .. (user.hwid or "N/A") .. "]" end
            
            local p
            if userRole == "OWNER" then p = SOwner:CreateParagraph(formatName, "Đang hoạt động")
            elseif userRole == "ADMIN" then p = SAdmin:CreateParagraph(formatName, "Đang hoạt động")
            else p = SUser:CreateParagraph(formatName, "Đang hoạt động") end
            
            onlineObjects[userId] = { p = p, role = userRole }
        end
    end

    for userId, obj in pairs(onlineObjects) do
        if not currentOnline[userId] then
            safelyDestroy(obj.p)
            onlineObjects[userId] = nil 
        end
    end
end

