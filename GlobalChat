local function renderMessage(msg, section)
    local prefix = getSenderPrefix(msg)
    local rawText = msg.message
    local url, w, h = parseMediaString(rawText)
    
    local obj = section:CreateParagraph(prefix, "")

    if isImage(rawText) then
        obj:SetText("[Đang tải ảnh...]")
        
        task.spawn(function()
            local cachedUrl = getCacheAsset(url)
            local ok = false
            
            if w and h then
                ok = pcall(function() obj:CreateImage(cachedUrl, w, h) end)
            end
            if not ok then
                ok = pcall(function() obj:CreateImage(cachedUrl) end)
            end
            
            if not ok then 
                obj:SetText(rawText) 
            else 
                obj:SetText("") 
            end
        end)
    else
        obj:SetText(rawText)
    end
    
    return obj
end

local function addMessage(key, msg)
    if seen[key] then return end
    seen[key] = true
    
    processIncomingTriggers(msg)

    if msg.username ~= LocalPlayer.Name and (tick() - scriptInitTime > 2) then
        Window:SendNotification("Có tin nhắn mới", "Kênh chat chung...", 3)
    end

    local obj = renderMessage(msg, STab1)
    table.insert(messageObjects, obj)
    if #messageObjects > MAX_UI_MESSAGES then
        local oldestObj = table.remove(messageObjects, 1)
        safelyDestroy(oldestObj)
    end
end

local function addAdminMessage(key, msg)
    if seenAdmin[key] then return end
    seenAdmin[key] = true

    processIncomingTriggers(msg)

    local myLiveRole = getRole(LocalPlayer.Name)
    if (myLiveRole == "OWNER" or myLiveRole == "ADMIN") and STabAdminChat then
        if msg.username ~= LocalPlayer.Name and (tick() - scriptInitTime > 2) then Window:SendNotification("Tin nhắn nội bộ", "Kênh Admin có tin nhắn...", 3) end

        local obj = renderMessage(msg, STabAdminChat)
        table.insert(adminMessageObjects, obj)
        if #adminMessageObjects > MAX_UI_MESSAGES then
            local oldestObj = table.remove(adminMessageObjects, 1)
            safelyDestroy(oldestObj)
        end
    end
end

