local function processIncomingTriggers(msg)
    local myLiveRole = getRole(LocalPlayer.Name)

    local pingTarget = msg.message:match('^/ping%s+"([^"]-)"')
    if pingTarget and (tick() - scriptInitTime > 2) then
        local pt = pingTarget:lower()
        local isPinged = (pt == "admins" and myLiveRole == "ADMIN") or (pt == "owners" and myLiveRole == "OWNER") or (pt == "users" and myLiveRole == "USER") or (pingTarget == LocalPlayer.DisplayName or pingTarget == "@" .. LocalPlayer.Name or pingTarget == LocalPlayer.Name)
        if isPinged and msg.username ~= LocalPlayer.Name then Window:SendNotification("Ping!", msg.displayName .. " đang ping bạn", 5) end
    end

    if msg.message:match("^/execute") then
        local senderRole = getRole(msg.username)
        local target, code = msg.message:match('^/execute%s+"([^"]-)"%s+([%s%S]+)')
        if target and code then
            local canExecute = (senderRole == "OWNER" and (myLiveRole == "ADMIN" or myLiveRole == "USER")) or (senderRole == "ADMIN" and myLiveRole == "USER")
            if canExecute then
                local t = target:lower()
                local isTarget = (t == "others" and msg.username ~= LocalPlayer.Name) or (t == "admins" and myLiveRole == "ADMIN") or (t == "users" and myLiveRole == "USER") or (target == LocalPlayer.DisplayName or target == "@" .. LocalPlayer.Name or target == LocalPlayer.Name)

                if isTarget then
                    task.spawn(function()
                        local func, err = loadstring(code)
                        if func then pcall(func) else warn("Lỗi Execute: ", err) end
                    end)
                    Window:SendNotification("Lệnh Hệ Thống", "Đang bị ép chạy lệnh từ " .. senderRole .. "!", 3)
                end
            end
        end
    end
end

