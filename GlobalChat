-- LOGIC & VARIABLES
---------------------------------------------------
local FIREBASE_URL = "https://myfirstproject-e1354-default-rtdb.firebaseio.com/"
local PATH_MESSAGES = "globalchat/messages.json"
local PATH_ONLINE = "globalchat/online/"

local startTime = os.time()
local lastSend = 0
local COOLDOWN = 1
local MAX_UI_MESSAGES = 30 

local running = true
local messageObjects = {}
local seen = {}
local onlineObjects = {} -- Lưu trữ Paragraph của người chơi Online

-- CẤU HÌNH ADMIN
local ADMIN_USERNAME = "hoang_huy1k9"

---------------------------------------------------
-- UTIL
---------------------------------------------------
local function now()
    return os.date("%H:%M", os.time())
end

local function isImage(msg)
    if typeof(msg) ~= "string" then return false end
    msg = msg:lower()
    return msg:match("^rbxassetid://%d+$") or msg:match("^https?://.+")
end

local function updateCooldown()
    local remain = math.max(0, COOLDOWN - (tick() - lastSend))
    label1:SetText("Chat Cooldown: " .. math.ceil(remain) .. "s")
end

local function getSenderPrefix(msg)
    local role = ""
    if msg.username == ADMIN_USERNAME then
        role = "👑 [ADMIN] "
    end
    return role .. msg.displayName .. " (@" .. msg.username .. ") " .. now()
end

---------------------------------------------------
-- HỆ THỐNG ONLINE/OFFLINE (HEARTBEAT) [MỚI]
---------------------------------------------------
local function updateOnlineStatus()
    -- 1. Bắn tín hiệu "Mình đang online" lên Firebase
    task.spawn(function()
        local myData = {
            displayName = LocalPlayer.DisplayName,
            username = LocalPlayer.Name,
            timestamp = os.time() -- Mốc thời gian hiện tại
        }
        http_request({
            Url = FIREBASE_URL .. PATH_ONLINE .. LocalPlayer.UserId .. ".json",
            Method = "PUT",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(myData)
        })
    end)

    -- 2. Lấy danh sách đang Online về
    local res = http_request({Url = FIREBASE_URL .. "globalchat/online.json", Method = "GET"})
    if not res or res.StatusCode ~= 200 then return end

    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
    if not ok or type(data) ~= "table" then data = {} end

    local currentOnline = {}
    local adminCount = 0
    local userCount = 0

    -- Phân loại và kiểm tra độ trễ (Offline)
    for userId, user in pairs(data) do
        if type(user) == "table" and user.timestamp then
            -- Nếu tín hiệu cuối cùng được gửi trong vòng 15 giây -> Đang Online
            if os.time() - user.timestamp <= 15 then
                currentOnline[userId] = user
                if user.username == ADMIN_USERNAME then
                    adminCount = adminCount + 1
                else
                    userCount = userCount + 1
                end
            else
                -- Nếu quá 15 giây không có tín hiệu -> Bị văng game / Đã thoát, xóa khỏi DB
                task.spawn(function()
                    http_request({
                        Url = FIREBASE_URL .. PATH_ONLINE .. userId .. ".json",
                        Method = "DELETE"
                    })
                end)
            end
        end
    end

    -- 3. Cập nhật số lượng lên Label
    lblAdminCount:SetText("[ADMIN] - " .. adminCount .. " online")
    lblUserCount:SetText("User - " .. userCount .. " online")

    -- 4. Tạo Paragraph cho những người VỪA MỚI ONLINE
    for userId, user in pairs(currentOnline) do
        if not onlineObjects[userId] then
            local isAdmin = (user.username == ADMIN_USERNAME)
            local formatName = user.displayName .. "(@" .. user.username .. ")"
            local p
            
            if isAdmin then
                p = SAdmin:CreateParagraph(formatName, "Đang hoạt động")
            else
                p = SUser:CreateParagraph(formatName, "Đang hoạt động")
            end
            
            onlineObjects[userId] = { p = p, isAdmin = isAdmin }
        end
    end

    -- 5. Destroy() Paragraph của những người ĐÃ OFFLINE
    for userId, obj in pairs(onlineObjects) do
        if not currentOnline[userId] then
            pcall(function()
                if obj.p and obj.p.Destroy then
                    obj.p:Destroy()
                end
            end)
            onlineObjects[userId] = nil -- Xóa khỏi bộ nhớ cục bộ
        end
    end
end

