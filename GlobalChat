local loopTick = 0
coroutine.wrap(function()
    while running do
        if isBanned then break end
        updateCooldown()
        fetchChat()
        checkRoleObserver()
        
        if loopTick % 3 == 0 then task.spawn(updateOnlineStatus) end
        if loopTick % 5 == 0 then task.spawn(checkBanStatus) end
        if loopTick % 10 == 0 then task.spawn(fetchRoles) end
        
        loopTick = loopTick + 1
        task.wait(1)
    end
end)()

