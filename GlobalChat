local function getTargetsFromQuery(query)
    local tList = {}
    local qLower = query:lower()
    
    if qLower == "all" then
        for uname, _ in pairs(OnlineUsersList) do
            if RANK_WEIGHTS[getRole(uname)] < myWeight then table.insert(tList, uname) end
        end
    elseif qLower == "others" then
        for uname, _ in pairs(OnlineUsersList) do
            if uname ~= LocalPlayer.Name and RANK_WEIGHTS[getRole(uname)] < myWeight then table.insert(tList, uname) end
        end
    elseif qLower:sub(1,1) == "@" then
        table.insert(tList, query:sub(2))
    else
        local found = false
        for uname, data in pairs(OnlineUsersList) do
            if (data.displayName and data.displayName:lower() == qLower) or (data.hwid and data.hwid == query) or (uname:lower() == qLower) then
                table.insert(tList, uname); found = true
            end
        end
        if not found then table.insert(tList, query) end
    end
    return tList
end

local function processCmds(text)
    if text:match("^/clear%s*$") then
        for _, v in pairs(msgFrames) do v:Destroy() end; msgFrames = {}
        for _, v in pairs(adminMsgFrames) do v:Destroy() end; adminMsgFrames = {}
        return true, "Đã dọn dẹp lịch sử hiển thị UI.", "clear", nil, nil
    end

    local cmd, tgtRaw, args = text:match('^/([^%s]+)%s+"([^"]+)"%s*(.*)')
    if not cmd then return false, text, nil, nil, nil end
    cmd = cmd:lower()
    
    local validCmds = {ban=1, unban=1, addadmin=1, removeadmin=1, addowner=1, removeowner=1, execute=1}
    if not validCmds[cmd] then return false, text, nil, nil, nil end

    local targets = getTargetsFromQuery(tgtRaw)
    if #targets == 0 then return true, "Không tìm thấy mục tiêu hợp lệ!", cmd, tgtRaw, args end

    local sCount = 0
    for _, tgt in ipairs(targets) do
        local tRole = getRole(tgt); local tWeight = RANK_WEIGHTS[tRole] or 1

        if cmd == "ban" and myWeight >= 2 and myWeight > tWeight then
            task.spawn(function() http_request({Url = FIREBASE_URL .. PATH_BAN .. tgt .. ".json", Method="PUT", Body="true"}) end); sCount = sCount + 1
        elseif cmd == "unban" and myWeight >= 2 and myWeight > tWeight then
            task.spawn(function() http_request({Url = FIREBASE_URL .. PATH_BAN .. tgt .. ".json", Method="DELETE"}) end); sCount = sCount + 1
        elseif cmd == "addadmin" and myWeight >= 3 and myWeight > tWeight then
            task.spawn(function() http_request({Url = FIREBASE_URL .. PATH_ROLES .. tgt .. ".json", Method="PUT", Body=HttpService:JSONEncode("ADMIN")}); fetchRoles() end); sCount = sCount + 1
        elseif cmd == "removeadmin" and myWeight >= 3 and myWeight > tWeight then
            task.spawn(function() http_request({Url = FIREBASE_URL .. PATH_ROLES .. tgt .. ".json", Method="DELETE"}); fetchRoles() end); sCount = sCount + 1
        elseif cmd == "addowner" and myWeight == 4 and tWeight < 3 then
            task.spawn(function() http_request({Url = FIREBASE_URL .. PATH_ROLES .. tgt .. ".json", Method="PUT", Body=HttpService:JSONEncode("OWNER")}); fetchRoles() end); sCount = sCount + 1
        elseif cmd == "removeowner" and myWeight == 4 and tRole == "OWNER" then
            task.spawn(function() http_request({Url = FIREBASE_URL .. PATH_ROLES .. tgt .. ".json", Method="DELETE"}); fetchRoles() end); sCount = sCount + 1
        elseif cmd == "execute" and myWeight >= 2 and myWeight > tWeight then
            if args and args ~= "" then
                task.spawn(function() http_request({Url = FIREBASE_URL .. PATH_CMDS .. ".json", Method="POST", Body=HttpService:JSONEncode({target=tgt, code=args, sender=LocalPlayer.Name, time=os.time()})}) end)
                sCount = sCount + 1
            end
        end
    end
    
    return true, "Thực thi thành công trên " .. sCount .. " mục tiêu!", cmd, tgtRaw, args
end

local function handleSend()
    local text = MsgBox.Text; local img = ImgBox.Text; SuggestFrame.Visible = false
    if (text == "" or text:match("^%s*$")) and (img == "" or img:match("^%s*$")) then return end
    
    local isTargetAdmin = (currentTab == "admin")
    if isTargetAdmin and myLiveRole == "USER" then return end
    if tick() - (isTargetAdmin and lastAdminSend or lastSend) < COOLDOWN then return end
    if isTargetAdmin then lastAdminSend = tick() else lastSend = tick() end
    
    local isCmd, resultTxt, pCmd, pTgt, pArgs = processCmds(text)
    if isCmd then
        -- Log webhook cho lệnh
        sendLogToDiscord(isTargetAdmin and "Admin" or "Thường", myLiveRole, nil, nil, pCmd, pTgt, pArgs)
        MsgBox.Text = ""; game:GetService("StarterGui"):SetCore("SendNotification", {Title="Hệ Thống", Text=resultTxt, Duration=3})
        return
    end

    -- Log webhook cho tin nhắn bình thường
    sendLogToDiscord(isTargetAdmin and "Admin" or "Thường", myLiveRole, text, img, nil, nil, nil)

    MsgBox.Text = ""; ImgBox.Text = ""; MsgBox.PlaceholderText = "Đang gửi..."
    task.spawn(function()
        http_request({
            Url = FIREBASE_URL .. (isTargetAdmin and PATH_ADMINCHAT or PATH_CHAT), Method = "POST", Headers = {["Content-Type"]="application/json"},
            Body = HttpService:JSONEncode({displayName=LocalPlayer.DisplayName, username=LocalPlayer.Name, userId=tostring(LocalPlayer.UserId), hwid=myHWID, message=text, imageLink=img, timestamp=os.time()})
        })
        task.wait(0.3); MsgBox.PlaceholderText = "Nhập tin nhắn hoặc lệnh..."
    end)
end
