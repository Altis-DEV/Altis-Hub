---------------------------------------------------
-- LOOP CHÍNH
---------------------------------------------------
local loopTick = 0

coroutine.wrap(function()
    while running do
        updateCooldown()
        fetch() -- Cập nhật tin nhắn (Mỗi 1 giây)
        
        -- Cứ mỗi 3 giây thì gửi tín hiệu Online và cập nhật danh sách
        if loopTick % 3 == 0 then
            task.spawn(updateOnlineStatus)
        end
        
        loopTick = loopTick + 1
        task.wait(1)
    end
end)()

