-- LOOP CHÍNH
---------------------------------------------------
local loopTick = 0

coroutine.wrap(function()
    while running do
        updateCooldown()
        fetch() 
        
        if loopTick % 3 == 0 then
            task.spawn(updateOnlineStatus)
        end
        
        loopTick = loopTick + 1
        task.wait(1)
    end
end)()

