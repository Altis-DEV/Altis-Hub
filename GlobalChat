---------------------------------------------------
-- LOOP
---------------------------------------------------
coroutine.wrap(function()
    while running do
        updateCooldown()
        fetch()
        task.wait(1)
    end
end)()

Window:SendNotification("Global Chat", "Đã tải xong hoàn chỉnh!", 3)
