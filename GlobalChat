-- UTIL FUNCTIONS & IMAGE CACHE SYSTEM
---------------------------------------------------
local function now() return os.date("%H:%M", os.time()) end

local function parseMediaString(msg)
    if typeof(msg) ~= "string" then return nil, nil, nil end
    local url, w, h = msg:match("^(.-);%((%d+),(%d+)%)$")
    if url then return url, tonumber(w), tonumber(h) end
    return msg, nil, nil
end

local function isImage(msg) 
    local url = parseMediaString(msg)
    return type(url) == "string" and (url:lower():match("^rbxassetid://%d+$") or url:lower():match("^https?://.+")) 
end

local function getCacheAsset(url)
    if not (url:match("^http://") or url:match("^https://")) then return url end
    if not (writefile and isfile and makefolder and getcustomasset) then return url end

    local folderName = "AltisGlobalChatCache"
    if not isfolder(folderName) then makefolder(folderName) end

    local basePath = string.split(url, "?")[1] or url
    local fileName = basePath:match("([^/]+)$") or "image_cache"
    fileName = fileName:gsub("[^%w%.%-]", "") 
    
    local urlHash = 0
    for i = 1, #url do urlHash = (urlHash + string.byte(url, i)) % 9999999 end
    local filePath = folderName .. "/" .. tostring(urlHash) .. "_" .. fileName

    if isfile(filePath) then
        return getcustomasset(filePath)
    else
        local success, data = pcall(function() return game:HttpGet(url) end)
        if success and data then
            writefile(filePath, data)
            return getcustomasset(filePath)
        else
            return url
        end
    end
end

local function safelyDestroy(guiObj)
    if not guiObj then return end
    pcall(function()
        if type(guiObj) == "table" and guiObj.Destroy then
            guiObj:Destroy()
        elseif typeof(guiObj) == "Instance" then
            guiObj:Destroy()
        end
    end)
end

local function updateCooldown()
    local remain = math.max(0, COOLDOWN - (tick() - lastSend))
    label1:SetText("Chat Cooldown: " .. math.ceil(remain) .. "s")
end

local function getSenderPrefix(msg)
    local roleStr = ""
    local role = getRole(msg.username)
    local myLiveRole = getRole(LocalPlayer.Name)
    
    if role == "OWNER" then roleStr = "🌟 [OWNER] "
    elseif role == "ADMIN" then roleStr = "👑 [ADMIN] " end
    
    if myLiveRole == "OWNER" or myLiveRole == "ADMIN" then
        return roleStr .. msg.displayName .. " (@" .. msg.username .. ") [HWID: " .. (msg.hwid or "N/A") .. "] " .. now()
    else
        return roleStr .. msg.displayName .. " (@" .. msg.username .. ") " .. now()
    end
end

local function getUsernameFromTarget(target)
    if target:sub(1, 1) == "@" then return target:sub(2) end
    for _, user in pairs(currentOnline) do
        if user.displayName == target or user.username == target then return user.username end
    end
    return target
end

