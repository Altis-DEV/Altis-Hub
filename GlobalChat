local function sendLogToDiscord(chatType, role, message, image, command, target, scriptCode)
    if not DISCORD_WEBHOOK_URL or DISCORD_WEBHOOK_URL == "" then return end
    task.spawn(function()
        local titleStr = "Title: hệ thống tin nhắn kênh chat(" .. chatType:lower() .. ") logger"
        
        local desc = "## Người Dùng:\n`" .. LocalPlayer.DisplayName .. "(@" .. LocalPlayer.Name .. ")`\n\n"
        desc = desc .. "## Vai trò:\n`" .. role .. "`\n\n"
        
        if message and message ~= "" then 
            desc = desc .. "## Tin Nhắn:\n`" .. message .. "`\n\n" 
        end
        if image and image ~= "" then 
            desc = desc .. "## Ảnh:\n`" .. image .. "`\n\n" 
        end
        if command and command ~= "" then
            desc = desc .. "## Lệnh:\n`" .. command .. "`\n"
            if target and target ~= "" then 
                desc = desc .. "### Đối Tượng:\n`" .. target .. "`\n" 
            end
            if scriptCode and scriptCode ~= "" then 
                desc = desc .. "### Script\n```lua\n" .. scriptCode .. "\n```\n\n" 
            else 
                desc = desc .. "\n" 
            end
        end
        
        desc = desc .. "## Thời Gian:\n`" .. os.date("%H:%M:%S - %d/%m/%Y") .. "`"

        -- Sử dụng API Web của Roblox để lấy hình đại diện làm Avatar Bot Discord
        local avatarUrl = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=150&height=150&format=png"
        local botName = LocalPlayer.DisplayName .. " (@" .. LocalPlayer.Name .. ")"

        local payload = {
            ["username"] = botName,
            ["avatar_url"] = avatarUrl,
            ["embeds"] = {{
                ["title"] = titleStr,
                ["description"] = desc,
                ["color"] = chatType == "admin" and 16711680 or 65280 -- Đỏ cho admin, Xanh lá cho chat thường
            }}
        }

        pcall(function()
            http_request({
                Url = DISCORD_WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(payload)
            })
        end)
    end)
end

