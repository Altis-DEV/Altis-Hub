local OWNERS = {
    ["hoang_huy1k9"] = true -- 54hz
}

local ADMINS = {
    ["rypzRXcHVG"] = true   -- ROBLOX777
}

local function getRole(username)
    if OWNERS[username] then return "OWNER" end
    if ADMINS[username] then return "ADMIN" end
    return "USER"
end

---------------------------------------------------
-- UTIL
---------------------------------------------------
local function now()
    return os.date("%H:%M", os.time())
end

local function isImage(msg)
    if typeof(msg) ~= "string" then return false end
    msg = msg:lower()
    return msg:match("^rbxassetid://%d+$") or msg:match("^https?://.+")
end

local function updateCooldown()
    local remain = math.max(0, COOLDOWN - (tick() - lastSend))
    label1:SetText("Chat Cooldown: " .. math.ceil(remain) .. "s")
end

local function getSenderPrefix(msg)
    local roleStr = ""
    local role = getRole(msg.username)
    
    if role == "OWNER" then
        roleStr = "🌟 [OWNER] "
    elseif role == "ADMIN" then
        roleStr = "👑 [ADMIN] "
    end
    
    return roleStr .. msg.displayName .. " (@" .. msg.username .. ") " .. now()
end

