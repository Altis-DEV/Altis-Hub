-- Hàm kiểm tra API 
local function checkAPI(apiName)
    local status = "⛔️"
    
    local success, result = pcall(function()
        -- 1. Xử lý hàm của game (Ví dụ: game:HttpGet)
        if string.find(apiName, "^game:") then
            local method = string.sub(apiName, 6)
            -- Lấy hàm từ biến game
            return game[method] ~= nil
        end
        
        -- 2. Xử lý bảng/hàm thông thường (Ví dụ: crypt.hash, getcustomasset)
        local parts = string.split(apiName, ".")
        local env = typeof(getgenv) == "function" and getgenv() or getfenv(0)
        
        local current = env
        for i, part in ipairs(parts) do
            if current[part] ~= nil then
                current = current[part]
            else
                -- Fallback sang các thư viện built-in
                local fbEnv = getfenv(0)
                if fbEnv[parts[1]] and type(fbEnv[parts[1]]) == "table" and fbEnv[parts[1]][part] ~= nil then
                    current = fbEnv[parts[1]][part]
                else
                    return false
                end
            end
        end
        return current ~= nil
    end)

    if success and result == true then
        status = "✅️"
    end
    return status
end

