-- 3. XỬ LÝ CHỌN KHỐI 3D (ĐA MỤC TIÊU)
-- ==========================================
local selectingMode = nil -- Chỉ dùng cho Ghế lái
local isSelectingTargets = false -- Toggle cho chế độ gom Khối
local selectedController = nil
local selectedTargets = {} -- Bảng chứa nhiều khối mục tiêu

local function updateTargetUI()
    BtnResetTargets.Text = "🗑️ Reset Khối Đã Chọn (" .. #selectedTargets .. ")"
    if isSelectingTargets then
        BtnTarget.Text = "🟢 Đang chọn... (" .. #selectedTargets .. ") [Bấm Dừng]"
        BtnTarget.BackgroundColor3 = Color3.fromRGB(230, 126, 34)
    else
        if #selectedTargets > 0 then
            BtnTarget.Text = "✅ Đã chốt " .. #selectedTargets .. " khối"
            BtnTarget.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        else
            BtnTarget.Text = "📦 2. Bật Chọn Đa Khối Mục Tiêu"
            BtnTarget.BackgroundColor3 = Color3.fromRGB(44, 62, 80)
        end
    end
end

BtnController.Activated:Connect(function()
    selectingMode = "Controller"
    isSelectingTargets = false
    updateTargetUI()
    
    BtnController.Text = "🎯 Chọn ghế lái/công tắc..."
    BtnController.BackgroundColor3 = Color3.fromRGB(230, 126, 34)
end)

BtnTarget.Activated:Connect(function()
    selectingMode = nil -- Hủy chế độ chọn ghế nếu đang bật
    if selectedController then
        BtnController.Text = "✅ Ghế: " .. selectedController.Name
        BtnController.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
    else
        BtnController.Text = "🎮 1. Chọn Ghế / Công Tắc"
        BtnController.BackgroundColor3 = Color3.fromRGB(44, 62, 80)
    end
    
    -- Chuyển đổi trạng thái Đang gom / Ngừng gom
    isSelectingTargets = not isSelectingTargets
    updateTargetUI()
end)

BtnResetTargets.Activated:Connect(function()
    selectedTargets = {}
    updateTargetUI()
end)

Mouse.Button1Down:Connect(function()
    if not selectingMode and not isSelectingTargets then return end
    local target = Mouse.Target
    if not target then return end
    
    local playerBlocks = workspace:FindFirstChild("Blocks") and workspace.Blocks:FindFirstChild(Name)
    if not playerBlocks then return end
    
    local current = target
    while current and current.Parent ~= playerBlocks do current = current.Parent end
    
    if current then
        if selectingMode == "Controller" then
            selectedController = current
            BtnController.Text = "✅ Ghế: " .. current.Name
            BtnController.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
            selectingMode = nil
            
        elseif isSelectingTargets then
            -- Chế độ Đa mục tiêu: Kiểm tra xem đã lưu khối này chưa
            local alreadyExists = false
            for _, t in ipairs(selectedTargets) do
                if t == current then alreadyExists = true break end
            end
            
            -- Nếu chưa có thì thêm vào danh sách
            if not alreadyExists then
                table.insert(selectedTargets, current)
                updateTargetUI()
            end
        end
    end
end)

-- ==========================================
-- 4. ĐÓNG GÓI DỮ LIỆU ĐA MỤC TIÊU & GỬI SERVER
-- ==========================================
local function findBindInstance(block, fallbacks)
    for _, childName in ipairs(fallbacks) do
        local match = block:FindFirstChild(childName)
        if match then return match end
    end
    for _, child in ipairs(block:GetChildren()) do
        if string.sub(child.Name, 1, 4) == "Bind" then return child end
    end
    return nil
end

BtnSubmit.Activated:Connect(function()
    Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    
    local bindTool = Character:FindFirstChild("BindTool")
    if not bindTool then
        bindTool = LocalPlayer.Backpack:FindFirstChild("BindTool")
        if bindTool and Humanoid then
            Humanoid:EquipTool(bindTool)
            task.wait(0.15)
        end
    end
    
    if not bindTool then
        BtnSubmit.Text = "❌ KHÔNG TÌM THẤY BINDTOOL!"
        task.delay(1.5, function() BtnSubmit.Text = "⚡ TIẾN HÀNH NỐI MẠCH" end)
        return
    end
    
    if not selectedController or #selectedTargets == 0 then
        BtnSubmit.Text = "❌ CHƯA CHỌN ĐỦ KHỐI/GHẾ!"
        task.delay(1.5, function() BtnSubmit.Text = "⚡ TIẾN HÀNH NỐI MẠCH" end)
        return
    end

    local RF = bindTool:FindFirstChild("RF")
    if not RF then return end

    local actionTable = {}
    local keycodeTable = {}
    local hasData = false

    -- Quét qua từng ô Textbox
    for _, row in ipairs(bindRows) do
        local rawText = textBoxes[row.Name].Text
        if rawText and rawText ~= "" then
            
            -- Thu thập tất cả instance chức năng từ NHIỀU khối mục tiêu
            local bindInstancesForThisKey = {}
            for _, targetBlock in ipairs(selectedTargets) do
                local bindInstance = findBindInstance(targetBlock, row.Fallbacks)
                if bindInstance then
                    table.insert(bindInstancesForThisKey, bindInstance)
                end
            end
            
            -- Nếu có ít nhất 1 khối bắt được lệnh kết nối
            if #bindInstancesForThisKey > 0 then
                -- Cắt chuỗi đa phím
                local keyStrings = string.split(rawText, ",")
                local validKeyCount = 0
                
                for _, keyStr in ipairs(keyStrings) do
                    local cleanStr = string.upper(string.gsub(keyStr, "%s+", ""))
                    if cleanStr ~= "" then
                        local keyCodeEnum = KeyMap[cleanStr]
                        if keyCodeEnum then
                            validKeyCount = validKeyCount + 1
                            local uniqueId = row.Name .. "_" .. tostring(validKeyCount)
                            
                            -- Đưa toản bộ MẢNG các instance vào actionTable (Tính năng Gộp dây siêu tốc)
                            actionTable[uniqueId] = bindInstancesForThisKey
                            keycodeTable[uniqueId] = keyCodeEnum.Value
                            hasData = true
                        end
                    end
                end
            end
        end
    end

    if not hasData then
        BtnSubmit.Text = "❌ LỖI: SAI TÊN PHÍM HOẶC KHỐI!"
        task.delay(1.5, function() BtnSubmit.Text = "⚡ TIẾN HÀNH NỐI MẠCH" end)
        return
    end

    -- Bắn luồng Server (Giả lập PC chuẩn)
    local success, err = pcall(function()
        RF:InvokeServer(actionTable, selectedController, keycodeTable, false, false)
    end)

    if success then
        BtnSubmit.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        BtnSubmit.Text = "✅ ĐÃ NỐI XONG (" .. #selectedTargets .. " Khối)!"
        
        -- Tự động ngắt chế độ chọn sau khi nối xong cho an toàn
        isSelectingTargets = false
        updateTargetUI()
        
        task.delay(1.5, function() 
            BtnSubmit.Text = "⚡ TIẾN HÀNH NỐI MẠCH" 
            BtnSubmit.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
        end)
    else
        BtnSubmit.Text = "❌ LỖI GỬI LỆNH!"
        task.delay(1.5, function() BtnSubmit.Text = "⚡ TIẾN HÀNH NỐI MẠCH" end)
    end
end)
