local function getCacheAsset(url)
    if not url or url == "" then return nil end
    if url:match("^rbxassetid://") then return url end
    
    if not (writefile and isfile and getcustomasset and isfolder and makefolder) then return nil end
    pcall(function() if not isfolder("AltisImagesV32") then makefolder("AltisImagesV32") end end)
    
    local hash = 0; for i = 1, #url do hash = (hash + string.byte(url, i)) % 9999999 end
    local ext = url:match("%.png") and ".png" or ".jpg"
    local path = "AltisImagesV32/" .. hash .. ext
    
    if isfile(path) then return getcustomasset(path) end
    local s, data = pcall(function() return game:HttpGet(url) end)
    if s and data then writefile(path, data); return getcustomasset(path) end
    return nil
end

