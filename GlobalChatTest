    local function GetHeader(
        Headers,
        Name
    )
        if type(Headers) ~= "table" then
            return nil
        end

        local Wanted =
            string.lower(
                Name
            )

        for Key, Value in pairs(
            Headers
        ) do

            if string.lower(
                tostring(Key)
            ) == Wanted then

                return tostring(
                    Value
                )
            end
        end

        return nil
    end

    --//====================================================
    --// REMOTE EXTENSIONS
    --//====================================================

    local function GetURLextension(URL)
        local Path =
            URL:match(
                "^https?://[^%?#]+"
            )

        if not Path then
            return nil
        end

        local Extension =
            Path:match(
                "%.([%w]+)$"
            )

        if Extension then
            return string.lower(
                Extension
            )
        end

        return nil
    end

    local function GetContentExtension(
        ContentType
    )
        if not ContentType then
            return nil
        end

        ContentType =
            string.lower(
                ContentType:match(
                    "^[^;]+"
                )
                or ContentType
            )

        local Map = {
            ["image/jpeg"] =
                "jpg",

            ["image/jpg"] =
                "jpg",

            ["image/png"] =
                "png",

            ["image/gif"] =
                "gif",

            ["image/webp"] =
                "webp",

            ["audio/mpeg"] =
                "mp3",

            ["audio/mp3"] =
                "mp3",

            ["audio/wav"] =
                "wav",

            ["audio/x-wav"] =
                "wav",

            ["audio/ogg"] =
                "ogg",

            ["audio/flac"] =
                "flac",

            ["audio/aac"] =
                "aac"
        }

        return Map[
            ContentType
        ]
    end

    --//====================================================
    --// DETECT REMOTE MEDIA TYPE
    --//====================================================

    local function DetectRemoteType(
        URL,
        ContentType,
        Body
    )

        local Type =
            ContentType
            and string.lower(
                ContentType
            )
            or ""

        if Type:match(
            "^image/"
        ) then
            return "image"
        end

        if Type:match(
            "^audio/"
        ) then
            return "audio"
        end

        local Extension =
            GetURLextension(
                URL
            )

        if Extension then

            local Images = {
                jpg = true,
                jpeg = true,
                png = true,
                gif = true,
                webp = true
            }

            local Audio = {
                mp3 = true,
                wav = true,
                ogg = true,
                flac = true,
                aac = true
            }

            if Images[
                Extension
            ] then
                return "image"
            end

            if Audio[
                Extension
            ] then
                return "audio"
            end
        end

        --// Magic bytes.

        if Body then

            --// PNG
            if Body:sub(
                1,
                8
            )
                == "\137PNG\r\n\026\n" then

                return "image"
            end

            --// JPEG
            if Body:sub(
                1,
                2
            )
                == "\255\216" then

                return "image"
            end

            --// GIF
            if Body:sub(
                1,
                6
            ) == "GIF87a"
                or Body:sub(
                    1,
                    6
                ) == "GIF89a" then

                return "image"
            end

            --// WEBP
            if Body:sub(
                1,
                4
            ) == "RIFF"
                and Body:sub(
                    9,
                    12
                ) == "WEBP" then

                return "image"
            end

            --// MP3 ID3
            if Body:sub(
                1,
                3
            ) == "ID3" then

                return "audio"
            end

            --// WAV
            if Body:sub(
                1,
                4
            ) == "RIFF"
                and Body:sub(
                    9,
                    12
                ) == "WAVE" then

                return "audio"
            end
        end

        return nil
    end

    --//====================================================
    --// IMAGE DIMENSIONS
    --//====================================================

    local function U16BE(
        Data,
        Position
    )
        local A,
            B =
            string.byte(
                Data,
                Position,
                Position + 1
            )

        if not A
            or not B then
            return nil
        end

        return A * 256 + B
    end

    local function U32BE(
        Data,
        Position
    )
        local A,
            B,
            C,
            D =
            string.byte(
                Data,
                Position,
                Position + 3
            )

        if not A
            or not B
            or not C
            or not D then
            return nil
        end

        return
            A * 16777216
            + B * 65536
            + C * 256
            + D
    end

    local function U16LE(
        Data,
        Position
    )
        local A,
            B =
            string.byte(
                Data,
                Position,
                Position + 1
            )

        if not A
            or not B then
            return nil
        end

        return A + B * 256
    end

    local function U24LE(
        Data,
        Position
    )
        local A,
            B,
            C =
            string.byte(
                Data,
                Position,
                Position + 2
            )

        if not A
            or not B
            or not C then
            return nil
        end

        return
            A
            + B * 256
            + C * 65536
    end

    local function JPEGSOF(
        Marker
    )
        return
            Marker == 0xC0
            or Marker == 0xC1
            or Marker == 0xC2
            or Marker == 0xC3
            or Marker == 0xC5
            or Marker == 0xC6
            or Marker == 0xC7
            or Marker == 0xC9
            or Marker == 0xCA
            or Marker == 0xCB
            or Marker == 0xCD
            or Marker == 0xCE
            or Marker == 0xCF
    end

    local function JPEGDimensions(
        Data
    )
        if Data:sub(
            1,
            2
        )
            ~= "\255\216" then
            return nil
        end

        local Position =
            3

        while Position
            < #Data do

            while Position <= #Data
                and string.byte(
                    Data,
                    Position
                ) ~= 0xFF do

                Position += 1
            end

            if Position >= #Data then
                break
            end

            while Position <= #Data
                and string.byte(
                    Data,
                    Position
                ) == 0xFF do

                Position += 1
            end

            local Marker =
                string.byte(
                    Data,
                    Position
                )

            if not Marker then
                break
            end

            Position += 1

            if Marker == 0xD9
                or Marker == 0xDA then

                break
            end

            if Marker >= 0xD0
                and Marker <= 0xD9 then

                continue
            end

            local Length =
                U16BE(
                    Data,
                    Position
                )

            if not Length
                or Length < 2 then
                break
            end

            if JPEGSOF(
                Marker
            ) then

                local Height =
                    U16BE(
                        Data,
                        Position + 3
                    )

                local Width =
                    U16BE(
                        Data,
                        Position + 5
                    )

                if Width
                    and Height
                    and Width > 0
                    and Height > 0 then

                    return Width,
                        Height
                end
            end

            Position +=
                Length
        end

        return nil
    end

    local function PNGDimensions(
        Data
    )
        if Data:sub(
            1,
            8
        )
            ~= "\137PNG\r\n\026\n" then
            return nil
        end

        local Width =
            U32BE(
                Data,
                17
            )

        local Height =
            U32BE(
                Data,
                21
            )

        if Width
            and Height
            and Width > 0
            and Height > 0 then

            return Width,
                Height
        end

        return nil
    end

    local function GIFDimensions(
        Data
    )
        local Header =
            Data:sub(
                1,
                6
            )

        if Header ~= "GIF87a"
            and Header ~= "GIF89a" then
            return nil
        end

        local Width =
            U16LE(
                Data,
                7
            )

        local Height =
            U16LE(
                Data,
                9
            )

        if Width
            and Height
            and Width > 0
            and Height > 0 then

            return Width,
                Height
        end

        return nil
    end

    local function WEBPDimensions(
        Data
    )
        if Data:sub(
            1,
            4
        ) ~= "RIFF"
            or Data:sub(
                9,
                12
            ) ~= "WEBP" then

            return nil
        end

        if Data:sub(
            13,
            16
        ) == "VP8X" then

            local WidthMinusOne =
                U24LE(
                    Data,
                    25
                )

            local HeightMinusOne =
                U24LE(
                    Data,
                    28
                )

            if WidthMinusOne
                and HeightMinusOne then

                return
                    WidthMinusOne + 1,
                    HeightMinusOne + 1
            end
        end

        return nil
    end

    local function GetImageDimensions(
        Data
    )
        local W,
            H

        W,
            H =
            PNGDimensions(
                Data
            )

        if W then
            return W,
                H
        end

        W,
            H =
            JPEGDimensions(
                Data
            )

        if W then
            return W,
                H
        end

        W,
            H =
            GIFDimensions(
                Data
            )

        if W then
            return W,
                H
        end

        W,
            H =
            WEBPDimensions(
                Data
            )

        if W then
            return W,
                H
        end

        return 1,
            1
    end

    --//====================================================
    --// DOWNLOAD / CACHE REMOTE MEDIA
    --//====================================================

    local function DownloadRemote(
        URL
    )

        --// Cache first.
        local Cached =
            MediaCache[
                URL
            ]

        if type(Cached)
            == "table"
            and Cached.file
            and SafeIsFile(
                Cached.file
            )
            and GetCustomAsset then

            local Success,
                Asset =
                pcall(
                    function()
                        return GetCustomAsset(
                            Cached.file
                        )
                    end
                )

            if Success then

                return true,
                    Asset,
                    Cached.kind,
                    {
                        Width =
                            tonumber(
                                Cached.width
                            ) or 1,

                        Height =
                            tonumber(
                                Cached.height
                            ) or 1
                    }
            end
        end

        --// Download.
        local Body
        local ContentType

        if Request then

            local Response =
                HttpRequest({
                    Url =
                        URL,

                    Method =
                        "GET"
                })

            if Response then

                local Code =
                    tonumber(
                        Response.StatusCode
                    )

                if not Code
                    or (
                        Code >= 200
                        and Code < 300
                    ) then

                    Body =
                        Response.Body

                    ContentType =
                        GetHeader(
                            Response.Headers
                            or Response.headers,

                            "Content-Type"
                        )
                end
            end
        end

        if not Body then

            Body =
                game:HttpGet(
                    URL
                )
        end

        if not Body then
            return false
        end

        local Kind =
            DetectRemoteType(
                URL,
                ContentType,
                Body
            )

        if not Kind then
            return false
        end

        if not GetCustomAsset then
            return false
        end

        local Extension =
            GetContentExtension(
                ContentType
            )
            or GetURLextension(
                URL
            )

        if not Extension then
            if Kind == "image" then
                Extension = "jpg"
            else
                Extension = "mp3"
            end
        end

        local FileName =
            os.date(
                "%Y_%m_%d_%H_%M_%S"
            )
            .. "."
            .. Extension

        if not SafeWriteFile(
            FileName,
            Body
        ) then
            return false
        end

        local AssetSuccess,
            Asset =
            pcall(
                function()
                    return GetCustomAsset(
                        FileName
                    )
                end
            )

        if not AssetSuccess then
            return false
        end

        local Width =
            1

        local Height =
            1

        if Kind == "image" then
            Width,
            Height =
                GetImageDimensions(
                    Body
                )
        end

        --// Only remote image cache is required.
        if Kind == "image" then

            MediaCache[
                URL
            ] = {
                file =
                    FileName,

                kind =
                    "image",

                width =
                    Width,

                height =
                    Height
            }

            SaveCache()
        end

        return true,
            Asset,
            Kind,
            {
                Width =
                    Width,

                Height =
                    Height
            }
    end

    --//====================================================
    --// ROBLOX ASSET DETECTION
    --//====================================================

    local function DetectRobloxAssetType(
        AssetId
    )
        local NumericId =
            tonumber(
                AssetId:match(
                    "(%d+)$"
                )
            )

        if not NumericId then
            return nil
        end

        --// Try Roblox information first.
        local Success,
            Info =
            pcall(
                function()
                    return MarketplaceService:GetProductInfo(
                        NumericId,
                        Enum.InfoType.Asset
                    )
                end
            )

        if Success
            and type(Info) == "table" then

            local AssetTypeId =
                tonumber(
                    Info.AssetTypeId
                )

            --// Audio
            if AssetTypeId == 3 then
                return "audio"
            end

            --// Image / Decal / Texture
            if AssetTypeId == 1
                or AssetTypeId == 2
                or AssetTypeId == 13 then

                return "image"
            end
        end

        --// Fallback test.
        local TestGui =
            Instance.new(
                "ScreenGui"
            )

        TestGui.ResetOnSpawn =
            false

        TestGui.Parent =
            PlayerGui

        local Image =
            Instance.new(
                "ImageLabel"
            )

        Image.Size =
            UDim2.fromOffset(
                1,
                1
            )

        Image.BackgroundTransparency =
            1

        Image.ImageTransparency =
            1

        Image.Image =
            AssetId

        Image.Parent =
            TestGui

        local Sound =
            Instance.new(
                "Sound"
            )

        Sound.SoundId =
            AssetId

        Sound.Parent =
            TestGui

        local Result =
            nil

        for _ = 1, 20 do

            local ImageLoaded =
                false

            local AudioLoaded =
                false

            pcall(
                function()
                    ImageLoaded =
                        Image.IsLoaded
                end
            )

            pcall(
                function()
                    AudioLoaded =
                        Sound.IsLoaded
                end
            )

            if ImageLoaded then
                Result =
                    "image"

                break
            end

            if AudioLoaded then
                Result =
                    "audio"

                break
            end

            task.wait(
                0.1
            )
        end

        pcall(
            function()
                TestGui:Destroy()
            end
        )

        return Result
    end

