    local function ParseRobloxAssetId(
        Text
    )
        Text =
            Trim(
                Text
            )

        local ID =
            Text:match(
                "^rbxassetid://(%d+)$"
            )

        if ID then
            return
                "rbxassetid://"
                .. ID
        end

        ID =
            Text:match(
                "^(%d+)$"
            )

        if ID then
            return
                "rbxassetid://"
                .. ID
        end

        return nil
    end

