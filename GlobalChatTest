-- HÀM PHÂN TÍCH NỘI DUNG ĐA ELEMENT (dấu ;)
-- Trả về mảng { type = "msg"|"image"|"audio"|"video", value = "..." }
---------------------------------------------------
local function parseElements(raw)
    local parts = {}
    for seg in (raw .. ";"):gmatch("([^;]*);") do
        local s = seg:gsub("^%s+", ""):gsub("%s+$", "")
        if s ~= "" then
            table.insert(parts, s)
        end
    end

    local result = {}
    for _, seg in ipairs(parts) do
        local lower = seg:lower()
        local isURL = seg:match("^https?://") or seg:match("^rbxassetid://")
        if isURL then
            if lower:match("%.mp3") or lower:match("%.wav") or lower:match("%.ogg") then
                table.insert(result, { type = "audio", value = seg })
            elseif lower:match("%.webm") then
                table.insert(result, { type = "video", value = seg })
            elseif lower:match("%.png") or lower:match("%.jpe?g") or lower:match("%.gif")
                or lower:match("rbxassetid://") and not lower:match("rbxasset") then
                table.insert(result, { type = "image", value = seg })
            else
                -- URL không rõ: thử nhận dạng bằng extension cuối
                table.insert(result, { type = "image", value = seg })
            end
        else
            table.insert(result, { type = "msg", value = seg })
        end
    end
    return result
end

