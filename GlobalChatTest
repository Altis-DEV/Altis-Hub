local lastSendTime = 0
local function handleSendMessage()
    local raw = MsgBox.Text
    if not raw or raw:match("^%s*$") then return end
    if tick() - lastSendTime < 1 then return end
    lastSendTime = tick()

    local elements = parseElements(raw)
    if #elements == 0 then return end

    MsgBox.Text = ""
    sendLogToDiscord(elements)

    task.spawn(function()
        -- Chuẩn bị payload (backward compat: vẫn lưu message/imageLink cho V33)
        local firstMsg, firstImg = "", ""
        for _, el in ipairs(elements) do
            if el.type == "msg" and firstMsg == "" then firstMsg = el.value end
            if el.type == "image" and firstImg == "" then firstImg = el.value end
        end

        http_request({
            Url = FIREBASE_URL .. PATH_CHAT,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({
                displayName = LocalPlayer.DisplayName,
                username = LocalPlayer.Name,
                userId = tostring(LocalPlayer.UserId),
                message = firstMsg,
                imageLink = firstImg,
                elements = elements,
                timestamp = os.time()
            })
        })

        -- Dọn tin nhắn cũ
        local checkRes = http_request({ Url = FIREBASE_URL .. PATH_CHAT .. '?shallow=true', Method = "GET" })
        if checkRes and checkRes.StatusCode == 200 and checkRes.Body ~= "null" then
            pcall(function()
                local keysData = HttpService:JSONDecode(checkRes.Body)
                if type(keysData) == "table" then
                    local keys = {}
                    for k, _ in pairs(keysData) do table.insert(keys, k) end
                    if #keys > 50 then
                        table.sort(keys)
                        for i = 1, #keys - 50 do
                            http_request({
                                Url = FIREBASE_URL .. "globalchat_v32/chat/" .. keys[i] .. ".json",
                                Method = "DELETE"
                            })
                        end
                    end
                end
            end)
        end
    end)
end

SendBtn.MouseButton1Click:Connect(handleSendMessage)
MsgBox.FocusLost:Connect(function(entered)
    if entered then handleSendMessage() end
end)

