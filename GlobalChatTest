    local function GetLastFirebaseKey()

        local URL =
            MESSAGES_URL
            .. '.json?orderBy=%22$key%22&limitToLast=1'

        local Success,
            Result =
            pcall(
                function()
                    return game:HttpGet(
                        URL
                    )
                end
            )

        if not Success then
            return false,
                nil,
                tostring(
                    Result
                )
        end

        local DecodeSuccess,
            Data =
            pcall(
                function()
                    return HttpService:JSONDecode(
                        Result
                    )
                end
            )

        if not DecodeSuccess then
            return false,
                nil,
                tostring(
                    Data
                )
        end

        if type(Data) ~= "table" then
            return true,
                nil,
                nil
        end

        local Keys =
            {}

        for Key in pairs(
            Data
        ) do

            Keys[
                #Keys + 1
            ] =
                Key

        end

        table.sort(
            Keys
        )

        return true,
            Keys[#Keys],
            nil
    end

    local function GetFirebaseMessages()

        local URL

        if LastKey then

            URL =
                MESSAGES_URL
                .. '.json?orderBy=%22$key%22&startAt=%22'
                .. tostring(
                    LastKey
                )
                .. '%22'

        else

            URL =
                MESSAGES_URL
                .. '.json?orderBy=%22$key%22'

        end

        local Success,
            Result =
            pcall(
                function()
                    return game:HttpGet(
                        URL
                    )
                end
            )

        if not Success then
            return false,
                nil,
                tostring(
                    Result
                )
        end

        local DecodeSuccess,
            Data =
            pcall(
                function()
                    return HttpService:JSONDecode(
                        Result
                    )
                end
            )

        if not DecodeSuccess then
            return false,
                nil,
                tostring(
                    Data
                )
        end

        if type(Data) ~= "table" then

            return true,
                {},
                nil
        end

        return true,
            Data,
            nil
    end

    local function SendFirebaseMessage(
        Message
    )

        local Data = {
            timestamp =
                os.time(),

            time =
                os.date(
                    "%H:%M:%S"
                ),

            displayName =
                Player.DisplayName,

            username =
                Player.Name,

            message =
                Message
        }

        local Success,
            Body =
            pcall(
                function()
                    return HttpService:JSONEncode(
                        Data
                    )
                end
            )

        if not Success then
            return false,
                tostring(
                    Body
                )
        end

        local Response,
            Error =
            HttpRequest({
                Url =
                    MESSAGES_URL
                    .. ".json",

                Method =
                    "POST",

                Headers = {
                    ["Content-Type"] =
                        "application/json"
                },

                Body =
                    Body
            })

        if not Response then

            return false,
                Error
                or "request failed"
        end

        local Code =
            tonumber(
                Response.StatusCode
            )

        if Code
            and Code >= 200
            and Code < 300 then

            return true
        end

        return false,
            "HTTP "
            .. tostring(
                Response.StatusCode
            )
    end

