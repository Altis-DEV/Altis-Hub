    -- Time display (right side)
    local TimeLbl = Instance.new("TextLabel", CtrlRow)
    TimeLbl.Size = UDim2.new(0, 85, 0, 28)
    TimeLbl.Position = UDim2.new(1, -85, 0, 1)
    TimeLbl.BackgroundTransparency = 1
    TimeLbl.Text = "0:00 / 0:00"
    TimeLbl.Font = Enum.Font.GothamBold
    TimeLbl.TextSize = 11
    TimeLbl.TextColor3 = COLORS.sub
    TimeLbl.TextXAlignment = Enum.TextXAlignment.Right
    TimeLbl.ZIndex = 9

    -- Progress slider row
    local SliderBg = Instance.new("Frame", AF)
    SliderBg.Size = UDim2.new(1, 0, 0, 18)
    SliderBg.BackgroundColor3 = COLORS.trackBg
    SliderBg.BorderSizePixel = 0
    SliderBg.ZIndex = 8
    Instance.new("UICorner", SliderBg).CornerRadius = UDim.new(0, 9)
    local AFSStroke = Instance.new("UIStroke", SliderBg)
    AFSStroke.Color = Color3.fromRGB(45, 45, 65)
    AFSStroke.Thickness = 1

    local SliderFill = Instance.new("Frame", SliderBg)
    SliderFill.Size = UDim2.new(0, 0, 1, 0)
    SliderFill.BackgroundColor3 = COLORS.trackFill
    SliderFill.BorderSizePixel = 0
    SliderFill.ZIndex = 9
    Instance.new("UICorner", SliderFill).CornerRadius = UDim.new(0, 9)

    local SliderKnob = Instance.new("Frame", SliderBg)
    SliderKnob.Size = UDim2.new(0, 20, 0, 20)
    SliderKnob.AnchorPoint = Vector2.new(0.5, 0.5)
    SliderKnob.Position = UDim2.new(0, 0, 0.5, 0)
    SliderKnob.BackgroundColor3 = Color3.fromRGB(220, 235, 255)
    SliderKnob.BorderSizePixel = 0
    SliderKnob.ZIndex = 10
    Instance.new("UICorner", SliderKnob).CornerRadius = UDim.new(1, 0)
    -- Inner dot for visual depth
    local KnobDot = Instance.new("Frame", SliderKnob)
    KnobDot.Size = UDim2.new(0, 8, 0, 8)
    KnobDot.AnchorPoint = Vector2.new(0.5, 0.5)
    KnobDot.Position = UDim2.new(0.5, 0, 0.5, 0)
    KnobDot.BackgroundColor3 = Color3.fromRGB(65, 130, 230)
    KnobDot.BorderSizePixel = 0
    KnobDot.ZIndex = 11
    Instance.new("UICorner", KnobDot).CornerRadius = UDim.new(1, 0)

    -- Sound instance
    local Sound = Instance.new("Sound", AF)
    Sound.Volume = 0.8
    Sound.Looped = false

    local looped = false
    local isPlaying = false
    local sliderDragging = false
    local resolvedSrc = nil
    -- localSeekTime: biến cục bộ kiểm soát thời gian seek, tránh race với Sound.TimePosition
    local localSeekTime = 0
    local useLocalSeek = false -- true khi đang kéo slider

    local function formatTime(s)
        s = math.max(0, math.floor(s))
        return string.format("%d:%02d", math.floor(s / 60), s % 60)
    end

    -- -----------------------------------------------
    -- STATE MACHINE: tự quản lý curTime, không tin Sound.TimePosition
    -- Roblox Sound:Play() reset TimePosition về 0 mỗi lần gọi.
    -- Giải pháp: Stop rồi Play, sau đó seek về curTime thủ công.
    -- -----------------------------------------------

    -- curTime: thời gian hiện tại do chúng ta quản lý (giây)
    -- Đây là source of truth duy nhất. Sound.TimePosition chỉ được đọc
    -- khi đang phát thực sự (không seek, không pause).
    local curTime = 0
    local lastHeartbeatTick = 0   -- os.clock() của frame trước, để tính delta

    local function applyVisual(t, dur)
        local frac = (dur > 0) and math.clamp(t / dur, 0, 1) or 0
        SliderFill.Size = UDim2.new(frac, 0, 1, 0)
        SliderKnob.Position = UDim2.new(frac, 0, 0.5, 0)
        TimeLbl.Text = formatTime(t) .. " / " .. formatTime(dur)
    end

    -- Hàm seek nội bộ: stop -> TimePosition -> play (nếu đang phát)
    -- Dùng Stop/Play thay vì Pause/Play vì Pause không bảo toàn vị trí đúng.
    local function seekTo(t)
        curTime = math.clamp(t, 0, Sound.TimeLength > 0 and Sound.TimeLength or 0)
        local wasPlaying = isPlaying
        Sound:Stop()                       -- reset engine về 0
        Sound.TimePosition = curTime       -- set trước khi Play
        if wasPlaying then
            Sound:Play()
            -- Roblox cần 1 frame để nhận TimePosition sau Play,
            -- nên ta set lại sau 1 frame nữa để chắc chắn
            task.defer(function()
                if isPlaying then
                    Sound.TimePosition = curTime
                end
            end)
        end
        applyVisual(curTime, Sound.TimeLength)
    end

    -- Resolve audio source
    task.spawn(function()
        local src = audioSrc
        if src:match("^rbxassetid://") then
            resolvedSrc = src
        elseif src:match("^https?://") then
            local cached = getCacheAsset(src, "AltisAudioV34")
            resolvedSrc = cached or src
        end
        Sound.SoundId = resolvedSrc or ""
    end)

    -- Heartbeat: khi đang phát, tự cộng delta vào curTime thay vì đọc Sound.TimePosition
    -- Điều này đảm bảo curTime không bao giờ bị reset bởi engine.
    local progressConn
    progressConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
        local dur = Sound.TimeLength
        if sliderDragging then
            applyVisual(localSeekTime, dur)
            return
        end
        if not isPlaying then return end
        curTime = curTime + dt
        if dur > 0 and curTime >= dur then
            if looped then
                -- Loop: reset curTime về 0, tiếp tục phát
                curTime = curTime - dur  -- giữ phần dư thay vì hard-reset để mượt hơn
                if curTime < 0 then curTime = 0 end
                applyVisual(curTime, dur)
            else
                -- Hết bài, không loop
                curTime = dur
                applyVisual(curTime, dur)
                -- Sound.Ended sẽ xử lý state (chỉ fire khi Looped = false)
            end
            return
        end
        applyVisual(curTime, dur)
    end)

    AF.Destroying:Connect(function()
        progressConn:Disconnect()
        Sound:Stop()
    end)

    -- Khi audio kết thúc tự nhiên (chỉ fire khi Sound.Looped = false)
    Sound.Ended:Connect(function()
        if looped then return end  -- guard: nếu looped thì heartbeat đã xử lý
        isPlaying = false
        curTime = 0
        PlayBtn.Text = "▶ Play"
        PlayBtn.BackgroundColor3 = COLORS.btnHover
        applyVisual(0, Sound.TimeLength)
    end)

    -- DidLoop: Roblox engine tự loop (Sound.Looped=true) — reset curTime về 0
    -- Quan trọng: phải handle cả trường hợp này vì engine loop độc lập với heartbeat delta
    Sound.DidLoop:Connect(function()
        curTime = 0
        applyVisual(0, Sound.TimeLength)
    end)

    -- Play / Pause
    PlayBtn.MouseButton1Click:Connect(function()
        if not resolvedSrc then return end
        if isPlaying then
            -- PAUSE: lưu curTime, dừng engine
            Sound:Stop()
            isPlaying = false
            PlayBtn.Text = "▶ Play"
            PlayBtn.BackgroundColor3 = COLORS.btnHover
            -- curTime không đổi — đây là điểm resume
        else
            -- PLAY / RESUME từ curTime
            isPlaying = true
            PlayBtn.Text = "⏸ Stop"
            PlayBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
            Sound:Stop()               -- đảm bảo engine reset trước
            Sound.TimePosition = curTime
            Sound:Play()
            task.defer(function()
                -- Roblox đôi khi bỏ qua TimePosition set trước Play,
                -- set lại sau 1 frame để chắc chắn
                if isPlaying then
                    Sound.TimePosition = curTime
                end
            end)
        end
    end)

    LoopBtn.MouseButton1Click:Connect(function()
        looped = not looped
        Sound.Looped = looped
        LoopBtn.BackgroundColor3 = looped and COLORS.btnHover or COLORS.btn
        LoopBtn.TextColor3 = looped and Color3.fromRGB(255, 255, 255) or COLORS.sub
    end)

    VolBox.FocusLost:Connect(function()
        local v = tonumber(VolBox.Text)
        if v then
            v = math.clamp(v, 0, 1)
            Sound.Volume = v
            VolBox.Text = string.format("%.2f", v)
        else
            VolBox.Text = string.format("%.2f", Sound.Volume)
        end
    end)

    -- Slider drag
    local function fracFromInput(inputPos)
        local absPos = SliderBg.AbsolutePosition
        local absSize = SliderBg.AbsoluteSize
        return math.clamp((inputPos.X - absPos.X) / absSize.X, 0, 1)
    end

    SliderBg.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            sliderDragging = true
            local frac = fracFromInput(inp.Position)
            localSeekTime = frac * (Sound.TimeLength > 0 and Sound.TimeLength or 0)
        end
    end)

    UserInputService.InputChanged:Connect(function(inp)
        if sliderDragging and (inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch) then
            local frac = fracFromInput(inp.Position)
            localSeekTime = frac * (Sound.TimeLength > 0 and Sound.TimeLength or 0)
        end
    end)

    UserInputService.InputEnded:Connect(function(inp)
        if sliderDragging and (inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch) then
            sliderDragging = false
            -- Commit: gọi seekTo để đồng bộ curTime + engine
            seekTo(localSeekTime)
        end
    end)

    return AF
end

