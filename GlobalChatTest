    --//====================================================
    --// IMAGE RESIZE
    --//====================================================

    local function UpdateImageRecord(
        Record
    )
        if not Record
            or not Record.Active then
            return
        end

        local Image =
            Record.Image

        if not Image
            or not Image.Parent then

            Record.Active =
                false

            return
        end

        if Record.Ratio <= 0 then
            return
        end

        local Width =
            ScrollFrame.AbsoluteSize.X

        if Width <= 0 then
            return
        end

        local Height =
            math.floor(
                Width
                / Record.Ratio
                + 0.5
            )

        Height =
            math.clamp(
                Height,
                IMAGE_MIN_HEIGHT,
                IMAGE_MAX_HEIGHT
            )

        Image.Size =
            UDim2.new(
                1,
                0,
                0,
                Height
            )
    end

    local function UpdateAllImages()
        for _, Record in ipairs(
            ImageRecords
        ) do

            UpdateImageRecord(
                Record
            )
        end
    end

