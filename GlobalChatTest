local lastSendTime = 0
local function handleSendMessage()
    local text = MsgBox.Text
    if not text or text:match("^%s*$") then return end
    if tick() - lastSendTime < 1 then return end -- Cooldown chống spam 1 giây
    lastSendTime = tick()
    
    -- Kiểm tra nếu người dùng nhập định dạng link ảnh kèm theo (ví dụ: Tấm hình đẹp | http://...)
    local messageContent, imageLink = text, ""
    if text:find("|") then
        local parts = string.split(text, "|")
        messageContent = parts[1]:gsub("^%s+", ""):gsub("%s+$", "")
        imageLink = parts[2]:gsub("^%s+", ""):gsub("%s+$", "")
    elseif text:match("^https?://") or text:match("^rbxassetid://") then
        imageLink = text
        messageContent = ""
    end

    MsgBox.Text = ""
    sendLogToDiscord(messageContent, imageLink)

    task.spawn(function()
        -- 1. Gửi tin nhắn mới lên Firebase
        http_request({
            Url = FIREBASE_URL .. PATH_CHAT,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                displayName = LocalPlayer.DisplayName,
                username = LocalPlayer.Name,
                userId = tostring(LocalPlayer.UserId),
                message = messageContent,
                imageLink = imageLink,
                timestamp = os.time()
            })
        })

        -- 2. Cơ chế tự động dọn rác Firebase (Giữ lại tối đa 50 tin nhắn mới nhất)
        local checkRes = http_request({Url = FIREBASE_URL .. PATH_CHAT .. '.json?shallow=true', Method = "GET"})
        if checkRes and checkRes.StatusCode == 200 and checkRes.Body ~= "null" then
            pcall(function()
                local keysData = HttpService:JSONDecode(checkRes.Body)
                if type(keysData) == "table" then
                    local keys = {}
                    for k, _ in pairs(keysData) do table.insert(keys, k) end
                    
                    -- Nếu số lượng tin nhắn vượt quá 50, tiến hành xóa các tin cũ nhất
                    if #keys > 50 then
                        table.sort(keys) -- Sắp xếp theo key thời gian tăng dần
                        local excessCount = #keys - 50
                        for i = 1, excessCount do
                            http_request({
                                Url = FIREBASE_URL .. "globalchat_v30/chat/" .. keys[i] .. ".json",
                                Method = "DELETE"
                            })
                        end
                    end
                end
            end)
        end
    end)
end

SendBtn.MouseButton1Click:Connect(handleSendMessage)
MsgBox.FocusLost:Connect(function(enterPressed)
