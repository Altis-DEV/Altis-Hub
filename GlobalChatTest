local function updateSuggestions(text)
    for _, v in ipairs(SuggestFrame:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    if text:sub(1,1) ~= "/" then SuggestFrame.Visible = false return end
    
    local parts = string.split(text, " "); local cmdQuery = parts[1]:sub(2):lower(); local targetQuery = parts[2] and parts[2]:gsub('"', '') or ""; local found = 0

    if #parts == 1 then
        for _, c in ipairs(COMMANDS) do
            if c.minRank <= myWeight and c.cmd:lower():sub(1, #cmdQuery) == cmdQuery then
                found = found + 1
                local b = Instance.new("TextButton", SuggestFrame); b.Size = UDim2.new(1,0,0,25); b.BackgroundTransparency=1; b.ZIndex=8
                b.Text = "/" .. c.cmd .. " - " .. c.desc; b.TextColor3 = Color3.fromRGB(200,255,200); b.Font = Enum.Font.Gotham; b.TextSize=12; b.TextXAlignment = Enum.TextXAlignment.Left
                b.MouseButton1Click:Connect(function() MsgBox.Text = "/" .. c.cmd .. ' "" '; MsgBox:CaptureFocus() end)
            end
        end
    elseif #parts >= 2 then
        local isValidCmd = false
        for _, c in ipairs(COMMANDS) do if c.cmd == cmdQuery and c.minRank <= myWeight then isValidCmd = true break end end
        if isValidCmd then
            for name, _ in pairs(OnlineUsersList) do
                if name:lower():sub(1, #targetQuery) == targetQuery:lower() then
                    found = found + 1
                    local b = Instance.new("TextButton", SuggestFrame); b.Size = UDim2.new(1,0,0,25); b.BackgroundTransparency=1; b.ZIndex=8
                    b.Text = "👤 " .. name; b.TextColor3 = Color3.fromRGB(255,200,100); b.Font = Enum.Font.Gotham; b.TextSize=12; b.TextXAlignment = Enum.TextXAlignment.Left
                    b.MouseButton1Click:Connect(function() MsgBox.Text = "/" .. cmdQuery .. ' "' .. name .. '" '; MsgBox:CaptureFocus() end)
                end
            end
        end
    end
    SuggestFrame.Size = UDim2.new(1, -95, 0, (found * 27) + 10)
    SuggestFrame.Position = UDim2.new(0, 10, 1, -85 - SuggestFrame.Size.Y.Offset - 5)
    SuggestFrame.Visible = (found > 0)
end
