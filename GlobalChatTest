local TARGET_KEYWORDS = {"all", "others"}

local function updateSuggestions()
    local input = MsgBox.Text
    if not input:match("^/") then
        AutoCompleteFrame.Visible = false
        return
    end

    for _, child in ipairs(AutoCompleteFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local parts = string.split(input, " ")
    local firstWord = parts[1]:lower()
    local suggestions = {}

    if #parts == 1 then
        -- Gợi ý danh sách Lệnh
        for _, item in ipairs(AVAILABLE_COMMANDS) do
            if item.cmd:lower():find(firstWord, 1, true) then
                table.insert(suggestions, {label = item.cmd, sub = item.desc, replaceText = item.cmd .. " "})
            end
        end
    else
        -- Gợi ý Target (all, others, username/displayName đang online)
        local targetPart = parts[2] or ""
        
        for _, kw in ipairs(TARGET_KEYWORDS) do
            if kw:find(targetPart:lower(), 1, true) then
                table.insert(suggestions, {label = kw, sub = "Mục tiêu nhóm", replaceText = parts[1] .. ' "' .. kw .. '" '})
            end
        end
        
        for uname, udata in pairs(currentOnlineUsers) do
            local dName = udata.displayName or uname
            if uname:lower():find(targetPart:lower(), 1, true) or dName:lower():find(targetPart:lower(), 1, true) then
                table.insert(suggestions, {
                    label = "@" .. uname, 
                    sub = dName .. " (Online)", 
                    replaceText = parts[1] .. ' "' .. uname .. '" '
                })
            end
        end
    end

    if #suggestions == 0 then
        AutoCompleteFrame.Visible = false
        return
    end

    AutoCompleteFrame.Visible = true
    for _, sugg in ipairs(suggestions) do
        local btn = Instance.new("TextButton", AutoCompleteFrame)
        btn.Size = UDim2.new(1, 0, 0, 28)
        btn.BackgroundColor3 = Color3.fromRGB(36, 36, 48)
        btn.Text = "  " .. sugg.label .. " — " .. sugg.sub
        btn.TextColor3 = Color3.fromRGB(220, 220, 240)
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 11
        btn.TextXAlignment = Enum.TextXAlignment.Left
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

        btn.MouseButton1Click:Connect(function()
            MsgBox.Text = sugg.replaceText
            MsgBox:CaptureFocus()
            AutoCompleteFrame.Visible = false
        end)
    end
end

