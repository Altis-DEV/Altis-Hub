local function processCmds(text)
    local cmd, tgt, args = text:match('^/([^%s]+)%s+"([^"]-)"(.*)')
    if not cmd then return false, text end
    
    if cmd == "clear" then
        for _, v in pairs(msgFrames) do v:Destroy() end; msgFrames = {}
        for _, v in pairs(adminMsgFrames) do v:Destroy() end; adminMsgFrames = {}
        return true, ""
    end

    local tgtRole = getRole(tgt); local tgtWeight = RANK_WEIGHTS[tgtRole] or 1

    if cmd == "ban" and myWeight >= 2 and myWeight > tgtWeight then
        task.spawn(function() http_request({Url = FIREBASE_URL .. PATH_BAN .. tgt .. ".json", Method="PUT", Body="true"}) end)
        return true, "Đã ban " .. tgt
    elseif cmd == "unban" and myWeight >= 2 then
        task.spawn(function() http_request({Url = FIREBASE_URL .. PATH_BAN .. tgt .. ".json", Method="DELETE"}) end)
        return true, "Đã unban " .. tgt
    elseif cmd == "addadmin" and myWeight == 3 then
        task.spawn(function() http_request({Url = FIREBASE_URL .. PATH_ROLES .. tgt .. ".json", Method="PUT", Body=HttpService:JSONEncode("ADMIN")}) fetchRoles() end)
        return true, "Đã cấp Admin cho " .. tgt
    elseif cmd == "removeadmin" and myWeight == 3 then
        task.spawn(function() http_request({Url = FIREBASE_URL .. PATH_ROLES .. tgt .. ".json", Method="DELETE"}) fetchRoles() end)
        return true, "Đã xóa quyền Admin của " .. tgt
    elseif cmd == "execute" and myWeight >= 2 and myWeight > tgtWeight then
        if args and args ~= "" then
            task.spawn(function() http_request({Url = FIREBASE_URL .. PATH_CMDS .. ".json", Method="POST", Body=HttpService:JSONEncode({target=tgt, code=args, sender=LocalPlayer.Name, time=os.time()})}) end)
            return true, "Đã gửi lệnh thực thi đến " .. tgt
        end
    end
    return false, text
end

local function handleSend()
    local text = MsgBox.Text; local img = ImgBox.Text; SuggestFrame.Visible = false
    if (text == "" or text:match("^%s*$")) and (img == "" or img:match("^%s*$")) then return end
    
    local isTargetAdmin = (currentTab == "admin")
    if isTargetAdmin and myLiveRole == "USER" then return end
    if tick() - (isTargetAdmin and lastAdminSend or lastSend) < COOLDOWN then return end
    if isTargetAdmin then lastAdminSend = tick() else lastSend = tick() end
    
    local isCmd, resultTxt = processCmds(text)
    if isCmd then
        MsgBox.Text = ""; game:GetService("StarterGui"):SetCore("SendNotification", {Title="Hệ Thống", Text=resultTxt, Duration=3})
        return
    end

    MsgBox.Text = ""; ImgBox.Text = ""; MsgBox.PlaceholderText = "Đang gửi..."
    task.spawn(function()
        http_request({
            Url = FIREBASE_URL .. (isTargetAdmin and PATH_ADMINCHAT or PATH_CHAT), Method = "POST", Headers = {["Content-Type"]="application/json"},
            Body = HttpService:JSONEncode({displayName=LocalPlayer.DisplayName, username=LocalPlayer.Name, userId=LocalPlayer.UserId, hwid=myHWID, message=text, imageLink=img, timestamp=os.time()})
        })
        task.wait(0.3); MsgBox.PlaceholderText = "Nhập tin nhắn hoặc lệnh (bắt đầu bằng /)..."
    end)
end
SendBtn.MouseButton1Click:Connect(handleSend)

