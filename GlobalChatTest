    --//====================================================
    --// INITIALIZATION
    --//====================================================

    local function Initialize()

        SetConnectionStatus(
            "Connect...",
            Color3.fromRGB(
                255,
                200,
                0
            )
        )

        local Success,
            Key,
            Error =
            GetLastFirebaseKey()

        if not Success then

            SetConnectionStatus(
                "Connected Error",
                Color3.fromRGB(
                    255,
                    80,
                    80
                )
            )

            warn(
                "[Chat v1.02] Firebase initialization failed: "
                .. tostring(
                    Error
                )
            )

            return false
        end

        LastKey =
            Key

        Initialized =
            true

        SetConnectionStatus(
            "Connected",
            Color3.fromRGB(
                80,
                255,
                120
            )
        )

        return true
    end

    --//====================================================
    --// POLLING
    --//====================================================

    task.spawn(
        function()

            while true do

                local Success =
                    false

                local InitSuccess,
                    InitError =
                    pcall(
                        Initialize
                    )

                if InitSuccess
                    and Initialize then

                    Success =
                        Initialize ~= nil
                end

                if InitSuccess then
                    break
                end

                warn(
                    "[Chat v1.02] Initialize error: "
                    .. tostring(
                        InitError
                    )
                )

                SetConnectionStatus(
                    "Connected Error",
                    Color3.fromRGB(
                        255,
                        80,
                        80
                    )
                )

                task.wait(
                    POLL_INTERVAL
                )
            end

            while task.wait(
                POLL_INTERVAL
            ) do

                local PollSuccess,
                    PollError =
                    pcall(
                        function()

                            if not Initialized then
                                return
                            end

                            local Success,
                                Data,
                                Error =
                                GetFirebaseMessages()

                            if not Success then

                                SetConnectionStatus(
                                    "Connected Error",
                                    Color3.fromRGB(
                                        255,
                                        80,
                                        80
                                    )
                                )

                                warn(
                                    "[Chat v1.02] Poll failed: "
                                    .. tostring(
                                        Error
                                    )
                                )

                                return
                            end

                            SetConnectionStatus(
                                "Connected",
                                Color3.fromRGB(
                                    80,
                                    255,
                                    120
                                )
                            )

                            local Keys =
                                {}

                            for Key in pairs(
                                Data
                            ) do

                                Keys[
                                    #Keys + 1
                                ] =
                                    Key
                            end

                            table.sort(
                                Keys
                            )

                            local NewMessages =
                                false

                            for _, Key in ipairs(
                                Keys
                            ) do

                                if not LastKey
                                    or Key > LastKey then

                                    local MessageData =
                                        Data[Key]

                                    if type(
                                        MessageData
                                    ) == "table" then

                                        local Success =
                                            AddMessage(
                                                MessageData
                                            )

                                        if Success then
                                            NewMessages =
                                                true
                                        end

                                        RemoveOldMessages()
                                    end

                                    LastKey =
                                        Key
                                end
                            end

                            if NewMessages then
                                ScrollToBottom()
                            end
                        end
                    )

                if not PollSuccess then

                    warn(
                        "[Chat v1.02] Poll runtime error: "
                        .. tostring(
                            PollError
                        )
                    )
                end
            end
        end
    )

