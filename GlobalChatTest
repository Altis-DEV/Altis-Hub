    local function AddImageMessage(
        Data,
        Asset,
        Dimensions
    )
        local Objects =
            {}

        --// Line 1
        Objects[
            #Objects + 1
        ] =
            CreateInfoLine(
                Data
            )

        --// Line 2
        local Image =
            Instance.new(
                "ImageLabel"
            )

        Image.Name =
            "ChatImage"

        Image.Parent =
            ScrollFrame

        Image.BackgroundTransparency =
            1

        Image.BorderSizePixel =
            0

        Image.AutomaticSize =
            Enum.AutomaticSize.None

        Image.ScaleType =
            Enum.ScaleType.Fit

        Image.LayoutOrder =
            NextOrder()

        --// X = Scale 1
        Image.Size =
            UDim2.new(
                1,
                0,
                0,
                1
            )

        Image.Image =
            Asset

        local Width =
            tonumber(
                Dimensions
                and Dimensions.Width
            )
            or 1

        local Height =
            tonumber(
                Dimensions
                and Dimensions.Height
            )
            or 1

        if Width <= 0 then
            Width = 1
        end

        if Height <= 0 then
            Height = 1
        end

        local Record = {
            Image =
                Image,

            Ratio =
                Width / Height,

            Active =
                true
        }

        ImageRecords[
            #ImageRecords + 1
        ] =
            Record

        Objects[
            #Objects + 1
        ] =
            Image

        UpdateImageRecord(
            Record
        )

        --// Line 3
        Objects[
            #Objects + 1
        ] =
            AddSpacer()

        MessageObjects[
            #MessageObjects + 1
        ] = {
            Objects =
                Objects,

            ImageRecord =
                Record
        }

        task.defer(
            function()
                UpdateImageRecord(
                    Record
                )
            end
        )
    end

    --//====================================================
    --// AUDIO
    --//====================================================

    local function AddAudioMessage(
        Data,
        Asset
    )
        local Objects =
            {}

        --// Line 1
        Objects[
            #Objects + 1
        ] =
            CreateInfoLine(
                Data
            )

        local Sound =
            Instance.new(
                "Sound"
            )

        Sound.Name =
            "ChatAudio"

        Sound.SoundId =
            Asset

        Sound.Volume =
            1

        Sound.Looped =
            true

        Sound.Parent =
            PlayerGui

        --// Wait for duration.
        local Start =
            os.clock()

        while not Sound.IsLoaded
            and (
                os.clock()
                - Start
            ) < 5 do

            task.wait(
                0.1
            )
        end

        local Duration =
            math.floor(
                Sound.TimeLength
                + 0.5
            )

        if Duration < 1 then
            Duration =
                1
        end

        --// Line 2
        local Updating =
            false

        local Slider =
            Scroll:SliderInt({
                Label =
                    "",

                Value =
                    0,

                Minimum =
                    0,

                Maximum =
                    Duration,

                Format =
                    "%.0f s",

                Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        19
                    ),

                LayoutOrder =
                    NextOrder(),

                Callback =
                    function(
                        _,
                        Value
                    )
                        if Updating then
                            return
                        end

                        local Seconds =
                            math.floor(
                                tonumber(
                                    Value
                                )
                                or 0
                            )

                        Seconds =
                            math.clamp(
                                Seconds,
                                0,
                                Duration
                            )

                        pcall(
                            function()
                                Sound.TimePosition =
                                    Seconds
                            end
                        )
                    end
            })

        Objects[
            #Objects + 1
        ] =
            Slider

        local Controls =
            Scroll:Row({
                Expanded =
                    true,

                LayoutOrder =
                    NextOrder()
            })

        Objects[
            #Objects + 1
        ] =
            Controls

        Controls:Button({
            Text =
                "Play",

            Callback =
                function()
                    pcall(
                        function()
                            Sound:Play()
                        end
                    )
                end
        })

        Controls:Button({
            Text =
                "Pause",

            Callback =
                function()
                    pcall(
                        function()
                            Sound:Pause()
                        end
                    )
                end
        })

        Controls:Checkbox({
            Label =
                "Looped",

            Value =
                true,

            Callback =
                function(
                    _,
                    Value
                )
                    Sound.Looped =
                        Value
                end
        })

        --// Sync slider.
        task.spawn(
            function()

                while Sound.Parent do

                    task.wait(
                        0.1
                    )

                    if Sound.IsPlaying
                        and Sound.TimeLength > 0 then

                        local Seconds =
                            math.floor(
                                Sound.TimePosition
                                + 0.5
                            )

                        Seconds =
                            math.clamp(
                                Seconds,
                                0,
                                Duration
                            )

                        Updating =
                            true

                        pcall(
                            function()
                                Slider:SetValue(
                                    Seconds
                                )
                            end
                        )

                        Updating =
                            false
                    end
                end
            end
        )

        --// Line 3
        Objects[
            #Objects + 1
        ] =
            AddSpacer()

        MessageObjects[
            #MessageObjects + 1
        ] = {
            Objects =
                Objects,

            Sound =
                Sound
        }
    end

    --//====================================================
