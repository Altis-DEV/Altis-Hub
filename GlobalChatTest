local function getTargets(query)
    local tList = {}; local qLower = query:lower()
    if qLower == "all" then for uname, _ in pairs(OnlineUsersList) do table.insert(tList, uname) end
    elseif qLower == "others" then for uname, _ in pairs(OnlineUsersList) do if uname ~= LocalPlayer.Name then table.insert(tList, uname) end end
    elseif qLower:sub(1,1) == "@" then table.insert(tList, query:sub(2))
    else
        local found = false
        for uname, data in pairs(OnlineUsersList) do
            if (data.displayName and data.displayName:lower() == qLower) or uname:lower() == qLower then table.insert(tList, uname); found = true end
        end
        if not found then table.insert(tList, query) end -- Cho case ban HWID trực tiếp
    end
    return tList
end

