local function getCacheAsset(url, subFolder)
    if not url or url == "" then return nil end
    if url:match("^rbxassetid://") then return url end
    if not (writefile and isfile and getcustomasset and isfolder and makefolder) then return nil end

    subFolder = subFolder or "AltisMediaV34"
    pcall(function()
        if not isfolder(subFolder) then makefolder(subFolder) end
    end)

    local hash = 0
    for i = 1, #url do hash = (hash + string.byte(url, i)) % 9999999 end

    local ext = ".bin"
    if url:match("%.png") then ext = ".png"
    elseif url:match("%.jpe?g") then ext = ".jpg"
    elseif url:match("%.mp3") then ext = ".mp3"
    elseif url:match("%.wav") then ext = ".wav"
    elseif url:match("%.webm") then ext = ".webm"
    elseif url:match("%.ogg") then ext = ".ogg"
    end

    local path = subFolder .. "/" .. hash .. ext
    if isfile(path) then return getcustomasset(path) end
    local s, data = pcall(function() return game:HttpGet(url) end)
    if s and data then
        writefile(path, data)
        return getcustomasset(path)
    end
    return nil
end

