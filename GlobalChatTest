local startTime = os.time()
task.spawn(function()
    local tickCounter = 0
    while getgenv().AltisV343_Loop do
        pcall(function()
            local res = http_request({
                Url = FIREBASE_URL .. PATH_CHAT .. '?orderBy="$key"&limitToLast=25',
                Method = "GET"
            })
            if res and res.StatusCode == 200 and res.Body ~= "null" then
                local data = HttpService:JSONDecode(res.Body)
                if type(data) == "table" then
                    local tempArr = {}
                    for k, v in pairs(data) do
                        if v and type(v) == "table" and v.timestamp >= startTime then
                            table.insert(tempArr, { key = k, val = v })
                        end
                    end
                    table.sort(tempArr, function(a, b) return a.val.timestamp < b.val.timestamp end)
                    for _, item in ipairs(tempArr) do
                        if not seenMsgs[item.key] then
                            seenMsgs[item.key] = true
                            renderMessage(item.val)
                        end
                    end
                end
            end
        end)

        if tickCounter % 3 == 0 then
            pcall(function()
                http_request({
                    Url = FIREBASE_URL .. PATH_ONLINE .. LocalPlayer.Name .. ".json",
                    Method = "PUT",
                    Body = HttpService:JSONEncode({
                        displayName = LocalPlayer.DisplayName,
                        username = LocalPlayer.Name,
                        userId = tostring(LocalPlayer.UserId),
                        timestamp = os.time()
                    })
                })
                local onlineRes = http_request({ Url = FIREBASE_URL .. PATH_ONLINE .. ".json", Method = "GET" })
                if onlineRes and onlineRes.StatusCode == 200 and onlineRes.Body ~= "null" then
                    local rawOnline = HttpService:JSONDecode(onlineRes.Body)
                    if type(rawOnline) == "table" then
                        local activeUsers = {}
                        for uname, udata in pairs(rawOnline) do
                            if udata and udata.timestamp and (os.time() - udata.timestamp <= 20) then
                                activeUsers[uname] = udata
                            end
                        end
                        updateOnlineTab(activeUsers)
                    end
                end
            end)
        end

        tickCounter = tickCounter + 1
        task.wait(2)
    end
end)

