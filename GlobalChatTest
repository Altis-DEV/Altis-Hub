    local function Trim(
        Text
    )
        return tostring(
            Text
        ):match(
            "^%s*(.-)%s*$"
        )
    end

    local function EscapeRichText(
        Text
    )
        return tostring(
            Text
        )
            :gsub(
                "&",
                "&amp;"
            )
            :gsub(
                "<",
                "&lt;"
            )
            :gsub(
                ">",
                "&gt;"
            )
            :gsub(
                '"',
                "&quot;"
            )
            :gsub(
                "'",
                "&apos;"
            )
    end

    local function IsSingleURL(
        Text
    )
        return Text:match(
            "^https?://[^%s]+$"
        ) ~= nil
    end

    local function NextOrder()
        LayoutOrder += 1
        return LayoutOrder
    end

    --//====================================================
