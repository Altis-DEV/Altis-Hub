local function getCacheAsset(url)
    if not url or url == "" then return nil end
    if url:match("^rbxassetid://") then return url end
    if not (hasWriteFile and hasIsFile and getAssetFunc and isfolder and makefolder) then return nil end
    
    pcall(function() if not isfolder("AltisImagesV30") then makefolder("AltisImagesV30") end end)
    local hash = 0; for i = 1, #url do hash = (hash + string.byte(url, i)) % 9999999 end
    local ext = url:match("%.png") and ".png" or ".jpg"
    local path = "AltisImagesV30/" .. hash .. ext
    
    if isfile(path) then return getAssetFunc(path) end
    local s, data = pcall(function() return game:HttpGet(url) end)
    if s and data then writefile(path, data); return getAssetFunc(path) end
    return nil
end

