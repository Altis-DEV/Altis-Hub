local function handleSend()
    local text = MsgBox.Text; local img = ImgBox.Text; SuggestFrame.Visible = false
    if (text == "" or text:match("^%s*$")) and (img == "" or img:match("^%s*$")) then return end
    
    local isTargetAdmin = (currentTab == "admin")
    if isTargetAdmin and myLiveRole == "USER" then return end
    if tick() - (isTargetAdmin and lastAdminSend or lastSend) < COOLDOWN then return end
    if isTargetAdmin then lastAdminSend = tick() else lastSend = tick() end
    
    local isCmd, resultTxt, pCmd, pTgt, pArgs = processCmds(text)
    if isCmd then
        sendLogToDiscord(isTargetAdmin and "Admin" or "Thường", myLiveRole, nil, nil, pCmd, pTgt, pArgs)
        MsgBox.Text = ""; game:GetService("StarterGui"):SetCore("SendNotification", {Title="Hệ Thống", Text=resultTxt, Duration=3})
        return
    end

    sendLogToDiscord(isTargetAdmin and "Admin" or "Thường", myLiveRole, text, img, nil, nil, nil)

    MsgBox.Text = ""; ImgBox.Text = ""; MsgBox.PlaceholderText = "Đang gửi..."
    task.spawn(function()
        http_request({
            Url = FIREBASE_URL .. (isTargetAdmin and PATH_ADMINCHAT or PATH_CHAT), Method = "POST", Headers = {["Content-Type"]="application/json"},
            Body = HttpService:JSONEncode({displayName=LocalPlayer.DisplayName, username=LocalPlayer.Name, userId=tostring(LocalPlayer.UserId), hwid=myHWID, message=text, imageLink=img, timestamp=os.time()})
        })
        task.wait(0.3); MsgBox.PlaceholderText = "Nhập tin nhắn hoặc lệnh..."
    end)
end
