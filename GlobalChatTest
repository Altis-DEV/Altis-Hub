local function sendLogToDiscord(message, image)
    if not DISCORD_WEBHOOK_URL or DISCORD_WEBHOOK_URL == "" then return end
    task.spawn(function()
        local desc = "## Người Gửi:\n`" .. LocalPlayer.DisplayName .. "(@" .. LocalPlayer.Name .. ")`\n\n"
        if message and message ~= "" then desc = desc .. "## Nội Dung:\n`" .. message .. "`\n\n" end
        if image and image ~= "" then desc = desc .. "## Hình Ảnh:\n`" .. image .. "`\n\n" end
        desc = desc .. "## Thời Gian:\n`" .. os.date("%H:%M:%S - %d/%m/%Y") .. "`"

        local avatarUrl = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. LocalPlayer.UserId .. "&width=150&height=150&format=png"
        local payload = {
            ["username"] = LocalPlayer.DisplayName .. " (@" .. LocalPlayer.Name .. ")",
            ["avatar_url"] = avatarUrl,
            ["embeds"] = {{
                ["title"] = "💬 Global Chat Log (V30.1)",
                ["description"] = desc,
                ["color"] = 3447003
            }}
        }
        pcall(function()
            http_request({
                Url = DISCORD_WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(payload)
            })
        end)
    end)
end

