local function autoCleanFirebaseChat()
    task.spawn(function()
        local res = http_request({Url = FIREBASE_URL .. PATH_CHAT .. ".json?shallow=true", Method = "GET"})
        if res and res.StatusCode == 200 and res.Body ~= "null" then
            pcall(function()
                local data = HttpService:JSONDecode(res.Body)
                local count, keys = 0, {}
                for k, _ in pairs(data) do count = count + 1; table.insert(keys, k) end
                
                if count > 50 then
                    -- Cần fetch lại chi tiết để sort theo timestamp (chỉ lấy những tin nhắn cũ để xóa)
                    local detailRes = http_request({Url = FIREBASE_URL .. PATH_CHAT .. '.json?orderBy="$key"&limitToFirst='..tostring(count - 50), Method = "GET"})
                    if detailRes and detailRes.StatusCode == 200 then
                        local toDelete = HttpService:JSONDecode(detailRes.Body)
                        for k, _ in pairs(toDelete) do
                            http_request({Url = FIREBASE_URL .. PATH_CHAT .. "/" .. k .. ".json", Method = "DELETE"})
                        end
                    end
                end
            end)
        end
    end)
end

