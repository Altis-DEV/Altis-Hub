    local function SafeIsFile(
        FileName
    )
        if not isfile then
            return false
        end

        local Success,
            Result =
            pcall(
                isfile,
                FileName
            )

        return Success
            and Result == true
    end

    local function SafeReadFile(
        FileName
    )
        if not readfile then
            return nil
        end

        local Success,
            Result =
            pcall(
                readfile,
                FileName
            )

        if Success then
            return Result
        end

        return nil
    end

    local function SafeWriteFile(
        FileName,
        Data
    )
        if not writefile then
            return false
        end

        local Success =
            pcall(
                writefile,
                FileName,
                Data
            )

        return Success
    end

    --//====================================================
    --// MEDIA CACHE
    --//====================================================

    local function LoadCache()

        if not SafeIsFile(
            CACHE_FILE
        ) then
            return
        end

        local Raw =
            SafeReadFile(
                CACHE_FILE
            )

        if not Raw
            or Raw == "" then
            return
        end

        local Success,
            Data =
            pcall(
                function()
                    return HttpService:JSONDecode(
                        Raw
                    )
                end
            )

        if Success
            and type(Data) == "table" then

            MediaCache =
                Data
        end
    end

    local function SaveCache()

        local Success,
            Raw =
            pcall(
                function()
                    return HttpService:JSONEncode(
                        MediaCache
                    )
                end
            )

        if not Success then
            return
        end

        SafeWriteFile(
            CACHE_FILE,
            Raw
        )
    end

    LoadCache()

