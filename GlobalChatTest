    local function NotifyMessage(
        Data
    )
        if not NotificationsEnabled then
            return
        end

        if tostring(
            Data.username
            or ""
        ) == Player.Name then
            return
        end

        pcall(
            function()

                ReGui:Notify({
                    Title =
                        tostring(
                            Data.displayName
                            or Data.username
                            or "Unknown"
                        )
                        .. "(@"
                        .. tostring(
                            Data.username
                            or "Unknown"
                        )
                        .. ")",

                    Content =
                        tostring(
                            Data.message
                            or ""
                        ),

                    Duration =
                        5
                })

            end
        )
    end

    --//====================================================
    --// ADD MESSAGE
    --//====================================================

    local function AddMessage(
        Data
    )
        local Message =
            Trim(
                Data.message
                or ""
            )

        if Message == "" then
            return false
        end

        --// Remote URL
        if IsSingleURL(
            Message
        ) then

            local Success,
                Asset,
                Kind,
                Dimensions =
                DownloadRemote(
                    Message
                )

            if Success then

                if Kind == "image" then

                    AddImageMessage(
                        Data,
                        Asset,
                        Dimensions
                    )

                    NotifyMessage(
                        Data
                    )

                    return true
                end

                if Kind == "audio" then

                    AddAudioMessage(
                        Data,
                        Asset
                    )

                    NotifyMessage(
                        Data
                    )

                    return true
                end
            end
        end

        --// Roblox asset ID
        local AssetId =
            ParseRobloxAssetId(
                Message
            )

        if AssetId then

            local Kind =
                DetectRobloxAssetType(
                    AssetId
                )

            if Kind == "image" then

                AddImageMessage(
                    Data,
                    AssetId,
                    {
                        Width = 1,
                        Height = 1
                    }
                )

                NotifyMessage(
                    Data
                )

                return true
            end

            if Kind == "audio" then

                AddAudioMessage(
                    Data,
                    AssetId
                )

                NotifyMessage(
                    Data
                )

                return true
            end
        end

        --// Normal text
        AddTextMessage(
            Data
        )

        NotifyMessage(
            Data
        )

        return true
    end

    --//====================================================
    --// REMOVE OLD
    --//====================================================

    local function RemoveOldMessages()

        while #MessageObjects
            > MAX_MESSAGES do

            local Oldest =
                table.remove(
                    MessageObjects,
                    1
                )

            if Oldest.ImageRecord then
                Oldest.ImageRecord.Active =
                    false
            end

            if Oldest.Sound then
                pcall(
                    function()
                        Oldest.Sound:Destroy()
                    end
                )
            end

            if Oldest.Objects then

                for _, Object in ipairs(
                    Oldest.Objects
                ) do

                    pcall(
                        function()
                            Object:Destroy()
                        end
                    )
                end
            end
        end

        for Index =
            #ImageRecords,
            1,
            -1 do

            local Record =
                ImageRecords[
                    Index
                ]

            if not Record.Active then

                table.remove(
                    ImageRecords,
                    Index
                )
            end
        end
    end

