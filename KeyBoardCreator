-- KẾT NỐI SỰ KIỆN (EVENTS)
-----------------------------------------

-- 1. Sự kiện nút Tạo Đơn Lẻ
createBtn.MouseButton1Click:Connect(function()
    local bName = nameInput.Text
    local bKeys = keyInput.Text
    if bName == "" or bKeys == "" then return end
    
    -- Tạo nút ở vị trí mặc định (X=50, Y=50)
    createVirtualButton(bName, bKeys, UDim2.new(0, 50, 0, 50))
    nameInput.Text = ""
    keyInput.Text = ""
end)

-- 2. Sự kiện nút Tạo Chuỗi (Bulk)
bulkBtn.MouseButton1Click:Connect(function()
    local rawText = bulkInput.Text
    if rawText == "" then return end
    
    -- Tách các bộ nút bởi dấu chấm phẩy ";"
    local configs = string.split(rawText, ";")
    local validCount = 0
    
    for _, configStr in ipairs(configs) do
        -- Tách tên và phím bởi dấu bằng "="
        if string.find(configStr, "=") then
            local parts = string.split(configStr, "=")
            if #parts >= 2 then
                -- string.match để xóa sạch khoảng trắng dư thừa
                local bName = string.match(parts[1], "^%s*(.-)%s*$")
                local bKeys = string.match(parts[2], "^%s*(.-)%s*$")
                
                if bName and bKeys and bName ~= "" and bKeys ~= "" then
                    -- Tính toán vị trí xếp ngang (mỗi nút cách nhau 60 pixel: kích thước 50 + khoảng hở 10)
                    local startX = 50 + (validCount * 60)
                    local startY = 120 -- Hiển thị tụt xuống một chút so với tạo đơn
                    
                    createVirtualButton(bName, bKeys, UDim2.new(0, startX, 0, startY))
                    validCount = validCount + 1
                end
            end
        end
    end
    
    bulkInput.Text = ""
end)
