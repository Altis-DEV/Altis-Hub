-- HÀM KHỞI TẠO NÚT ẢO (TÁI SỬ DỤNG)
-----------------------------------------
local buttonContainer = Instance.new("Folder")
buttonContainer.Name = "VirtualButtons"
buttonContainer.Parent = screenGui

local function createVirtualButton(btnName, keysStr, spawnPos)
    local virtualFrame = Instance.new("Frame")
    virtualFrame.Size = UDim2.new(0, 50, 0, 50)
    virtualFrame.Position = spawnPos
    virtualFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    virtualFrame.Parent = buttonContainer
    Instance.new("UICorner", virtualFrame).CornerRadius = UDim.new(0, 6)
    
    local virtualBtn = Instance.new("TextButton")
    virtualBtn.Size = UDim2.new(1, 0, 1, 0)
    virtualBtn.BackgroundTransparency = 1
    virtualBtn.Text = btnName
    virtualBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    virtualBtn.Font = Enum.Font.GothamBold
    virtualBtn.TextSize = 11
    virtualBtn.TextWrapped = true
    virtualBtn.Parent = virtualFrame
    
    local deleteBtn = Instance.new("TextButton")
    deleteBtn.Size = UDim2.new(0, 16, 0, 16)
    deleteBtn.Position = UDim2.new(1, -16, 0, 0)
    deleteBtn.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    deleteBtn.Text = "X"
    deleteBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    deleteBtn.Font = Enum.Font.GothamBold
    deleteBtn.TextSize = 9
    deleteBtn.Parent = virtualFrame
    Instance.new("UICorner", deleteBtn).CornerRadius = UDim.new(0, 3)
    
    deleteBtn.MouseButton1Click:Connect(function()
        virtualFrame:Destroy()
    end)
    
    -- Draggable & Hold Key Logic
    local dragging = false
    local dragInput, dragStart, startPosDragging
    local keysToPress = string.split(keysStr, ",")

    virtualBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosDragging = virtualFrame.Position
            
            -- Key Down
            for _, keyRaw in ipairs(keysToPress) do
                local cleanKey = string.upper(string.match(keyRaw, "^%s*(.-)%s*$"))
                local successCode, keyCode = pcall(function() return Enum.KeyCode[cleanKey] end)
                if successCode and keyCode then
                    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
                end
            end

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    if dragging then
                        dragging = false
                        -- Key Up
                        for _, keyRaw in ipairs(keysToPress) do
                            local cleanKey = string.upper(string.match(keyRaw, "^%s*(.-)%s*$"))
                            local successCode, keyCode = pcall(function() return Enum.KeyCode[cleanKey] end)
                            if successCode and keyCode then
                                VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
                            end
                        end
                    end
                end
            end)
        end
    end)

    virtualBtn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            virtualFrame.Position = UDim2.new(
                startPosDragging.X.Scale, startPosDragging.X.Offset + delta.X, 
                startPosDragging.Y.Scale, startPosDragging.Y.Offset + delta.Y
            )
        end
    end)
end

